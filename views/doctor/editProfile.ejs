<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Edit Profile | MedPortal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap" rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="/js/doctor/tailwind-config.js"></script>
    <link rel="stylesheet" href="/css/doctor/common.css">
</head>

<body class="bg-background text-on-surface flex h-screen overflow-hidden">
    <!-- Side Navigation Bar -->
    <%- include("partials/leftNavBar.ejs") %>
    
    <!-- Main Wrapper -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden w-full">
        <!-- Top Navigation Bar -->
        <%- include("partials/topHeader.ejs") %>
        
        <!-- Main Content Area -->
        <main class="p-4 lg:p-xl flex-1 overflow-y-auto">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-8">
                <div>
                    <h2 class="font-display-lg text-display-lg text-primary">Edit Profile</h2>
                    <p class="text-body-lg text-on-surface-variant mt-1">Update your personal and professional information</p>
                </div>
                <a href="/doctor/profile" class="flex items-center gap-2 px-4 py-2 bg-white border border-outline-variant rounded-lg text-label-lg hover:bg-surface-container-low transition-colors">
                    Cancel
                </a>
            </div>

            <div class="flex flex-col lg:flex-row gap-8 max-w-7xl">
                <form id="editProfileForm" class="flex-1 space-y-8 max-w-4xl">
                <!-- Hidden fields for degrees and specialities to retain them during PATCH -->
                <input type="hidden" id="specialitiesData" value='<%- JSON.stringify(doctor.speciality || []) %>'>
                <input type="hidden" id="degreesData" value='<%- JSON.stringify(doctor.degree || []) %>'>

                <!-- Readonly Section (Credential Data) -->
                <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_4px_12px_rgba(0,0,0,0.05)]">
                    <h3 class="font-headline-sm text-headline-sm text-primary mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined">lock</span> Account Credentials
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Email Address</label>
                            <input type="email" value="<%= doctor.credential?.email %>" disabled class="w-full bg-surface-variant/50 text-on-surface-variant rounded-lg border-none px-4 py-3 opacity-70 cursor-not-allowed">
                            <p class="text-[11px] mt-1 text-on-surface-variant/70">Contact support to change your email</p>
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Phone Number</label>
                            <input type="text" value="<%= doctor.credential?.mobile %>" disabled class="w-full bg-surface-variant/50 text-on-surface-variant rounded-lg border-none px-4 py-3 opacity-70 cursor-not-allowed">
                        </div>
                    </div>
                </div>

                <!-- Personal Information -->
                <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_4px_12px_rgba(0,0,0,0.05)]">
                    <h3 class="font-headline-sm text-headline-sm text-primary mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined">person</span> Personal Information
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">First Name <span class="text-error">*</span></label>
                            <input type="text" name="firstName" value="<%= doctor.firstName %>" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Middle Name</label>
                            <input type="text" name="middleName" value="<%= doctor.middleName || '' %>" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Last Name <span class="text-error">*</span></label>
                            <input type="text" name="lastName" value="<%= doctor.lastName %>" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Date of Birth <span class="text-error">*</span></label>
                            <% 
                                let dobFormatted = "";
                                if(doctor.dateOfBirth) {
                                    const d = new Date(doctor.dateOfBirth);
                                    dobFormatted = d.toISOString().split('T')[0];
                                }
                            %>
                            <input type="date" name="dateOfBirth" value="<%= dobFormatted %>" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Gender</label>
                            <select name="gender" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                                <option value="MALE" <%= doctor.gender === 'MALE' ? 'selected' : '' %>>Male</option>
                                <option value="FEMALE" <%= doctor.gender === 'FEMALE' ? 'selected' : '' %>>Female</option>
                                <option value="OTHER" <%= doctor.gender === 'OTHER' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                        <!-- Removed profile photo url input -->
                    </div>
                </div>

                <!-- Professional Information -->
                <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_4px_12px_rgba(0,0,0,0.05)]">
                    <h3 class="font-headline-sm text-headline-sm text-primary mb-6 flex items-center gap-2">
                        <span class="material-symbols-outlined">medical_services</span> Professional Information
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Experience (Years) <span class="text-error">*</span></label>
                            <input type="number" name="expereince" min="0" value="<%= doctor.expereince || 0 %>" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Consultation Fee ($) <span class="text-error">*</span></label>
                            <input type="number" name="charges" min="0" value="<%= doctor.charges %>" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Slot Duration (Minutes) <span class="text-error">*</span></label>
                            <input type="number" name="slotDuration" min="5" step="5" value="<%= doctor.slotDuration || 15 %>" required class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all">
                        </div>
                        <div>
                            <label class="block text-label-sm text-on-surface-variant mb-1">Preferred Languages</label>
                            <input type="text" name="preferedLanguages" value="<%= Array.isArray(doctor.preferedLanguages) ? doctor.preferedLanguages.join(', ') : (doctor.preferedLanguages || '') %>" class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg px-4 py-2 focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all" placeholder="e.g. English, Spanish">
                            <p class="text-[11px] mt-1 text-on-surface-variant/70">Comma separated</p>
                        </div>
                    </div>
                </div>

                <div class="flex justify-end gap-4 mt-8 pb-12">
                    <button type="submit" class="bg-primary text-on-primary px-8 py-3 rounded-lg font-label-lg active:scale-95 transition-transform hover:shadow-lg flex items-center gap-2">
                        <span class="material-symbols-outlined">save</span>
                        Save Changes
                    </button>
                </div>
                </form>

                <!-- Profile Photo Sidebar -->
                <div class="w-full lg:w-80 shrink-0">
                    <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_4px_12px_rgba(0,0,0,0.05)] flex flex-col items-center sticky top-8">
                        <h3 class="font-headline-sm text-headline-sm text-primary mb-6 w-full text-center">Profile Photo</h3>
                        
                        <div class="relative group mb-6">
                            <div class="w-40 h-40 rounded-full overflow-hidden border-4 border-surface-variant/50 bg-surface-container-low shadow-sm">
                                <img id="profileImagePreview" src="<%= doctor.profilePhoto || '/images/default-avatar.svg' %>" onerror="this.onerror=null; this.src='/images/default-avatar.svg';" alt="Profile Photo" class="w-full h-full object-cover">
                            </div>
                        </div>
                        
                        <input type="file" id="profilePhotoInput" accept="image/*" class="hidden">
                        <button type="button" onclick="document.getElementById('profilePhotoInput').click()" class="w-full bg-secondary-container text-on-secondary-container hover:bg-secondary-fixed-dim px-4 py-2 rounded-lg font-label-lg transition-colors flex items-center justify-center gap-2 mb-3 shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">photo_camera</span>
                            Select Photo
                        </button>
                        <button type="button" id="uploadPhotoBtn" class="w-full bg-primary text-on-primary px-4 py-2 rounded-lg font-label-lg transition-colors flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed hidden shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">upload</span>
                            Upload & Save
                        </button>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        window.AppConfig = {
            serverPort: "<%= serverPort %>"
        };
    </script>
    <script src="/js/doctor/editProfile.js"></script>
</body>

</html>
