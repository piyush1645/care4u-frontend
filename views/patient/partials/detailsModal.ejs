<!-- Details Modal -->
<div id="detailsModal" style="display:none" class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4 animate-fade-in">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <h3 class="font-bold text-lg text-slate-800 flex items-center gap-2">
                <span class="material-symbols-outlined text-primary">clinical_notes</span>
                Appointment Details
            </h3>
            <button onclick="closeDetailsModal()" class="p-1.5 rounded-lg hover:bg-slate-100 transition-colors cursor-pointer">
                <span class="material-symbols-outlined text-slate-500">close</span>
            </button>
        </div>
        
        <div class="space-y-4">
            <!-- Prescription Section -->
            <div class="space-y-2">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wide flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm text-primary">prescriptions</span>
                    Doctor's Prescription & Precautions
                </h4>
                <div id="modalPrescriptionBox" class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-700 min-h-16 flex items-center">
                    <!-- Precautions text goes here -->
                </div>

                <div>
                    <button id="downloadPrescriptionBtn" type="button"
                        class="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg text-xs font-medium flex items-center gap-2 transition-all active:scale-95 border border-slate-200 hover:bg-slate-200 cursor-pointer">
                        <span class="material-symbols-outlined text-base">receipt_long</span>
                        Download Prescription
                    </button>
                </div>
            </div>

            <!-- Billing Section -->
            <div class="space-y-2">
                <h4 class="text-xs font-bold text-slate-400 uppercase tracking-wide flex items-center gap-1.5">
                    <span class="material-symbols-outlined text-sm text-emerald-600">receipt_long</span>
                    Billing & Payment Summary
                </h4>
                <div class="bg-emerald-50/50 border border-emerald-100 rounded-xl p-4 space-y-2.5 text-sm">
                    <div class="flex justify-between text-slate-600">
                        <span>Consultation Fees:</span>
                        <span id="modalConsultationFees" class="font-semibold text-slate-800">—</span>
                    </div>
                    <div class="flex justify-between text-slate-600">
                        <span>Taxes & Service Charges:</span>
                        <span id="modalTaxCharges" class="font-semibold text-slate-800">—</span>
                    </div>
                    <div class="border-t border-emerald-100/70 my-1"></div>
                    <div class="flex justify-between font-bold text-slate-800">
                        <span>Total Paid Amount:</span>
                        <span id="modalTotalAmount" class="text-emerald-700 text-base">—</span>
                    </div>
                    <div class="flex justify-between text-xs text-slate-500 pt-1">
                        <span>Payment Status:</span>
                        <span id="modalPaymentStatus" class="font-bold text-emerald-600 uppercase tracking-wide">Paid</span>
                    </div>
                </div>
                <div>
                    <button id="downloadInvoiceBtn" type="button"
                        class="bg-slate-100 text-slate-700 px-4 py-2 rounded-lg text-xs font-medium flex items-center gap-2 transition-all active:scale-95 border border-slate-200 hover:bg-slate-200 cursor-pointer">
                        <span class="material-symbols-outlined text-base">receipt_long</span>
                        Download Invoice
                    </button>
                </div>
            </div>
        </div>

        <div class="pt-2">
            <button onclick="closeDetailsModal()" class="w-full bg-slate-100 text-slate-700 py-2.5 rounded-xl text-sm font-medium hover:bg-slate-200 transition-colors cursor-pointer">
                Dismiss
            </button>
        </div>
    </div>
</div>
