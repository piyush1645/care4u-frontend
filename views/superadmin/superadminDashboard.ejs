<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Super Admin Dashboard | Care4U</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F4F5F7;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .custom-shadow {
            box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.05);
        }
        input, select {
            outline: none;
        }
        input:focus, select:focus {
            border-color: var(--md-sys-color-primary, #003d9b);
        }
    </style>
</head>
<body class="bg-background text-on-surface min-h-screen">

    <!-- Sidebar Overlay for mobile -->
    <div id="sidebar-overlay" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-40 hidden lg:hidden"></div>

    <!-- Sidebar (matching the Care4U sidebar design) -->
    <aside id="sidebar"
        class="fixed inset-y-0 left-0 z-50 w-[260px] bg-white text-slate-700 flex flex-col border-r border-slate-100 shadow-sm -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
        
        <!-- Logo -->
        <div class="h-20 flex items-center px-6 shrink-0 mt-2 border-b border-slate-100 mb-2">
            <div class="w-10 h-10 bg-primary text-on-primary rounded-lg flex items-center justify-center mr-3 shrink-0 shadow-sm">
                <span class="material-symbols-outlined text-[22px]">admin_panel_settings</span>
            </div>
            <div class="flex flex-col">
                <h1 class="font-bold text-primary text-[18px] leading-tight">MediCare</h1>
                <p class="text-[11px] text-slate-500 font-medium">Super Admin Portal</p>
            </div>
        </div>

        <!-- Navigation Links -->
        <nav class="flex-1 overflow-y-auto py-2 px-4 space-y-1">
            <a href="/superadmin/dashboard" class="flex items-center gap-4 px-4 py-3 rounded-lg bg-primary text-on-primary font-medium mb-1 shadow-sm">
                <span class="material-symbols-outlined mr-3">dashboard</span>
                <span class="text-[14px]">Dashboard</span>
            </a>
            <a href="/superadmin/analytics" class="flex items-center gap-4 px-4 py-3 rounded-lg text-slate-600 hover:bg-slate-50 transition-colors font-medium mb-1">
                <span class="material-symbols-outlined mr-3">analytics</span>
                <span class="text-[14px]">Analytics</span>
            </a>
        </nav>

        <!-- Bottom Actions & User Profile -->
        <div class="px-6 py-4 shrink-0 border-t border-slate-100 flex flex-col gap-3">
            <div class="flex items-center gap-3 py-2 px-1">
                <div class="w-9 h-9 rounded-full bg-primary/10 text-primary font-bold flex items-center justify-center text-sm shrink-0">
                    SA
                </div>
                <div class="overflow-hidden">
                    <p class="text-xs font-semibold text-slate-700 truncate">Super Admin</p>
                    <p class="text-[10px] text-slate-500 truncate">superadmin@hms.com</p>
                </div>
            </div>
            <a href="/logout"
                class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-red-50 transition-colors text-[#dc2626] font-medium">
                <span class="material-symbols-outlined text-[20px]">logout</span>
                <span class="text-[14px]">Logout</span>
            </a>
        </div>
    </aside>

    <!-- Header (aligned correctly to desktop viewport offset) -->
    <header class="fixed top-0 right-0 w-full lg:w-[calc(100%-260px)] h-20 bg-surface-container-lowest border-b border-outline-variant flex items-center justify-between px-md z-30 backdrop-blur-sm">
        <div class="flex items-center">
            <!-- Mobile Sidebar Toggle -->
            <button onclick="toggleSidebar()" class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg mr-2 flex items-center justify-center">
                <span class="material-symbols-outlined text-[24px]">menu</span>
            </button>
            <div>
                <h2 class="font-headline-lg text-xl sm:text-headline-lg text-primary">Super Admin Directory</h2>
                <p class="font-label-sm text-label-sm text-on-surface-variant hidden sm:block">Manage hospital groups and administrative credentials</p>
            </div>
        </div>
        <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
                <p class="text-xs font-semibold text-slate-700">Root Access</p>
                <p class="text-[10px] text-slate-400">Global Admin</p>
            </div>
            <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-600 font-bold text-sm border border-slate-200">
                SA
            </div>
        </div>
    </header>

    <!-- Main Workspace Area -->
    <main class="ml-0 lg:ml-[260px] pt-24 p-md min-h-screen space-y-md">
        
        <!-- Statistics Bento Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
            <!-- Card 1 -->
            <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 flex items-center gap-4">
                <div class="p-3 bg-primary/10 rounded-lg text-primary">
                    <span class="material-symbols-outlined text-[28px]">domain</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Hospital Groups</p>
                    <p id="groupCountText" class="font-headline-md text-headline-md text-on-surface font-bold">0</p>
                </div>
            </div>

            <!-- Card 2 -->
            <div class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 flex items-center gap-4">
                <div class="p-3 bg-secondary/10 rounded-lg text-secondary">
                    <span class="material-symbols-outlined text-[28px]">admin_panel_settings</span>
                </div>
                <div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Group Administrators</p>
                    <p id="adminCountText" class="font-headline-md text-headline-md text-on-surface font-bold">0</p>
                </div>
            </div>
        </div>

        <!-- Bento Layout Content -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-md">
            
            <!-- Left Panel: Directory Table -->
            <div class="col-span-12 lg:col-span-8 bg-surface-container-lowest rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 overflow-hidden">
                <div class="p-md border-b border-outline-variant flex justify-between items-center bg-surface-container-low">
                    <h3 class="font-headline-md text-headline-md text-on-surface font-bold">Registered Hospital Groups</h3>
                    <button onclick="refreshData()" class="flex items-center gap-1 text-label-sm text-primary font-semibold hover:underline">
                        <span class="material-symbols-outlined text-[16px]">refresh</span>
                        Sync
                    </button>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-surface-container-low border-b border-outline-variant">
                            <tr>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Group</th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Admin</th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Contact</th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Status</th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="groupTableBody" class="divide-y divide-outline-variant/30">
                            <tr>
                                <td colspan="5" class="text-center py-12 text-on-surface-variant text-sm">
                                    <div class="flex flex-col items-center justify-center gap-2">
                                        <span class="material-symbols-outlined animate-spin text-[32px] text-primary">progress_activity</span>
                                        <span>Loading hospital groups directory...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Right Panel: Quick Forms -->
            <div class="col-span-12 lg:col-span-4 space-y-md">
                <!-- Tabs -->
                <div class="bg-surface-container-lowest p-1 rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 flex gap-1">
                    <button onclick="switchTab('group')" id="tabBtnGroup" class="flex-1 py-2 rounded-lg font-semibold text-xs transition-all duration-200 bg-primary text-on-primary shadow-sm">
                        Add Group
                    </button>
                    <button onclick="switchTab('admin')" id="tabBtnAdmin" class="flex-1 py-2 rounded-lg font-semibold text-xs transition-all duration-200 text-on-surface-variant hover:bg-surface-container-low">
                        Add Admin
                    </button>
                </div>

                <!-- Form Card: Add Group -->
                <div id="formGroupCard" class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 space-y-4">
                    <div>
                        <h4 class="font-bold text-on-surface text-base">Add Hospital Group</h4>
                        <p class="text-xs text-on-surface-variant">Register a new tenant group in Care4U.</p>
                    </div>
                    <form id="groupForm" class="space-y-3" onsubmit="handleGroupSubmit(event)">
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Group Name *</label>
                            <input type="text" id="groupName" required placeholder="e.g. Apollo Group" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Logo URL *</label>
                            <input type="url" id="groupLogo" required placeholder="e.g. https://domain.com/logo.png" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                        </div>
                        <button type="submit" class="w-full bg-primary text-on-primary font-semibold py-2.5 rounded-xl text-xs hover:bg-primary/90 transition-all shadow-md active:scale-95">
                            Register Group
                        </button>
                    </form>
                </div>

                <!-- Form Card: Add Admin -->
                <div id="formAdminCard" class="bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30 space-y-4 hidden">
                    <div>
                        <h4 class="font-bold text-on-surface text-base">Add Group Admin</h4>
                        <p class="text-xs text-on-surface-variant">Create root credentials for a hospital group.</p>
                    </div>
                    <form id="adminForm" class="space-y-3" onsubmit="handleAdminSubmit(event)">
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Hospital Group *</label>
                            <select id="adminGroupSelect" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary bg-transparent transition-colors">
                                <option value="" disabled selected>Select Group</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-on-surface-variant mb-1">First Name *</label>
                                <input type="text" id="adminFirstName" required placeholder="John" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-on-surface-variant mb-1">Last Name *</label>
                                <input type="text" id="adminLastName" required placeholder="Doe" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                            </div>
                        </div>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-on-surface-variant mb-1">Gender *</label>
                                <select id="adminGender" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary bg-transparent transition-colors">
                                    <option value="MALE">Male</option>
                                    <option value="FEMALE">Female</option>
                                    <option value="OTHER">Other</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-on-surface-variant mb-1">Date of Birth *</label>
                                <input type="date" id="adminDOB" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Email Address *</label>
                            <input type="email" id="adminEmail" required placeholder="admin@domain.com" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Mobile Number *</label>
                            <input type="tel" id="adminMobile" required placeholder="9876543210" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Password *</label>
                            <input type="password" id="adminPassword" required placeholder="Min. 8 characters" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm focus:border-primary transition-colors">
                        </div>
                        <button type="submit" class="w-full bg-primary text-on-primary font-semibold py-2.5 rounded-xl text-xs hover:bg-primary/90 transition-all shadow-md active:scale-95">
                            Register Admin
                        </button>
                    </form>
                </div>

            </div>
        </div>

    </main>

    <!-- Load external dashboard logic -->
    <script src="/js/superadmin/superadminDashboard.js"></script>
</body>
</html>
