<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Doctor Registration | MediFlow Admin</title>
    <link rel="stylesheet" href="/css/output.css">
    <!-- Google Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #F4F5F7;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .form-input {
            transition: all 0.2s ease-in-out;
        }
        .form-input:focus {
            border-color: #003d9b;
            box-shadow: 0 0 0 2px rgba(0, 61, 155, 0.1);
        }
        .chip {
            animation: popIn 0.2s ease-out;
        }
        @keyframes popIn {
            0% { transform: scale(0.9); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body class="bg-background text-on-surface">
    <%- include('../admin/partial/navBar') %>
    
    <header class="fixed top-0 right-0 w-[calc(100%_-_260px)] h-20 bg-surface-container-lowest dark:bg-surface-dim border-b border-outline-variant flex items-center justify-between px-md z-40 backdrop-blur-sm">
        <div>
            <h2 class="font-headline-lg text-headline-lg text-primary">
                Register New Doctor
            </h2>
        </div>
    </header>

    <main class="ml-[260px] pt-24 p-md min-h-screen">
        <div class="max-w-7xl mx-auto">
            <div id="error-message" class="hidden mb-6 p-4 text-sm text-error bg-error-container rounded-lg" role="alert"></div>
            <div id="success-message" class="hidden mb-6 p-4 text-sm text-success bg-success-container rounded-lg" role="alert"></div>

            <div class="flex flex-col lg:flex-row gap-8">
                <!-- Left: Form -->
                <form id="doctorRegisterForm" class="flex-1 space-y-6 max-w-4xl bg-surface-container-lowest p-lg rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30">
                    <!-- Row 1: Names -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">First Name <span class="text-error">*</span></label>
                            <input type="text" name="firstName" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="John">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Middle Name</label>
                            <input type="text" name="middleName" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="William">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Last Name <span class="text-error">*</span></label>
                            <input type="text" name="lastName" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="Doe">
                        </div>
                    </div>

                    <!-- Row 2: Credentials -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Email Address <span class="text-error">*</span></label>
                            <input type="email" name="email" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="john.doe@mediflow.com">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Mobile Number <span class="text-error">*</span></label>
                            <input type="tel" name="mobile" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="e.g. 9876543210">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Password <span class="text-error">*</span></label>
                            <input type="password" name="password" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="••••••••">
                        </div>
                    </div>

                    <!-- Row 3: Personal Details -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Gender <span class="text-error">*</span></label>
                            <select name="gender" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                                <option value="" disabled selected>Select Gender</option>
                                <option value="MALE">Male</option>
                                <option value="FEMALE">Female</option>
                                <option value="OTHER">Other</option>
                            </select>
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Date of Birth <span class="text-error">*</span></label>
                            <input type="date" name="dateOfBirth" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Preferred Languages <span class="text-error">*</span></label>
                            <input type="text" name="preferedLanguages" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="English, Spanish (comma-separated)">
                        </div>
                    </div>

                    <!-- Row 4: Professional Info -->
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-md">
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Experience (Years)</label>
                            <input type="number" name="expereince" min="0" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="0">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Consultation Charges ($) <span class="text-error">*</span></label>
                            <input type="number" name="charges" required min="0" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="e.g. 150">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Slot Duration (Min)</label>
                            <input type="number" name="slotDuration" min="5" max="120" value="15" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                        </div>
                        <div>
                            <label class="block font-label-md text-label-md mb-2 text-on-surface-variant">Hospital Branch <span class="text-error">*</span></label>
                            <select name="hospitalId" required class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                                <option value="" disabled selected>Select Hospital</option>
                                <% hospitals.forEach(hospital => { %>
                                    <option value="<%= hospital.id %>"><%= hospital.branchName || hospital.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <!-- Refined Specialities Section -->
                    <div class="bg-surface-container-low/30 p-md rounded-xl border border-outline-variant/30">
                        <label class="block font-label-md text-label-md font-semibold text-primary mb-3">Specialities <span class="text-error">*</span></label>
                        
                        <div class="flex gap-2 mb-3">
                            <input type="text" id="specialityInput" class="form-input flex-1 px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface" placeholder="e.g. Cardiology, Neurology (press Add or Enter)">
                            <button type="button" id="addSpecialityBtn" class="px-4 py-2 bg-secondary text-on-secondary hover:bg-secondary/90 rounded-lg font-semibold flex items-center gap-1 transition-colors">
                                <span class="material-symbols-outlined text-[18px]">add</span> Add
                            </button>
                        </div>
                        
                        <div id="specialitiesContainer" class="flex flex-wrap gap-2 min-h-[48px] p-2.5 bg-surface border border-outline-variant/20 rounded-lg items-center">
                            <p id="noSpecialitiesText" class="text-sm text-on-surface-variant/50 italic ml-2">No specialities added yet.</p>
                        </div>
                        <!-- Hidden input to hold specialities array -->
                        <input type="hidden" id="specialitiesData" required>
                    </div>

                    <!-- Refined Degrees Section -->
                    <div class="bg-surface-container-low/30 p-md rounded-xl border border-outline-variant/30 space-y-4">
                        <div class="flex justify-between items-center">
                            <label class="block font-label-md text-label-md font-semibold text-primary">Degrees & Education <span class="text-error">*</span></label>
                            <button type="button" id="addDegreeBtn" class="flex items-center gap-1 text-sm bg-primary/10 text-primary px-3 py-1.5 rounded-lg hover:bg-primary/20 font-semibold transition-colors">
                                <span class="material-symbols-outlined text-[16px]">add</span> Add Degree
                            </button>
                        </div>
                        
                        <div id="degreesList" class="space-y-4">
                            <!-- Card #1 by default -->
                            <div class="degree-card p-5 border border-outline-variant/40 rounded-xl bg-surface-container-lowest relative shadow-sm border-l-4 border-primary">
                                <div class="flex justify-between items-center mb-4">
                                    <h4 class="font-headline-sm text-[15px] font-bold text-on-surface-variant flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[18px] text-primary">school</span>
                                        Degree #1
                                    </h4>
                                    <button type="button" class="remove-degree-btn text-error hover:bg-error-container/10 rounded-lg p-1.5 transition-colors hidden">
                                        <span class="material-symbols-outlined text-[20px]">delete</span>
                                    </button>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <div>
                                        <label class="block text-label-sm text-on-surface-variant mb-1.5">Course Name</label>
                                        <input type="text" required name="degreeCourseName[]" placeholder="e.g. Bachelor of Medicine" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                                    </div>
                                    <div>
                                        <label class="block text-label-sm text-on-surface-variant mb-1.5">Abbreviation</label>
                                        <input type="text" required name="degreeAbbreviation[]" placeholder="e.g. MBBS" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                                    </div>
                                    <div>
                                        <label class="block text-label-sm text-on-surface-variant mb-1.5">Institution</label>
                                        <input type="text" required name="degreeInstitution[]" placeholder="e.g. Harvard Medical School" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                                    </div>
                                    <div>
                                        <label class="block text-label-sm text-on-surface-variant mb-1.5">Passing Year</label>
                                        <input type="number" required name="degreePassingYear[]" placeholder="e.g. 2015" min="1950" max="2030" class="form-input w-full px-3 py-2 border border-outline rounded-lg focus:outline-none bg-surface">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex justify-end gap-md pt-4">
                        <a href="/admin/doctors" class="px-5 py-2.5 border border-outline rounded-xl hover:bg-surface-container-high transition-colors">Cancel</a>
                        <button type="submit" id="submitBtn" class="px-6 py-2.5 bg-primary text-on-primary font-semibold rounded-xl hover:bg-primary-container hover:shadow-md transition-all flex items-center gap-2">
                            Register Doctor
                        </button>
                    </div>
                </form>

                <!-- Right: Profile Photo Sidebar -->
                <div class="w-full lg:w-80 shrink-0">
                    <div class="bg-surface-container-lowest rounded-xl p-8 shadow-[0px_4px_12px_rgba(0,0,0,0.05)] flex flex-col items-center sticky top-24 border border-outline-variant/30">
                        <h3 class="font-headline-sm text-headline-sm text-primary mb-6 w-full text-center">Profile Photo</h3>
                        
                        <div class="relative group mb-6">
                            <div class="w-40 h-40 rounded-full overflow-hidden border-4 border-surface-variant/50 bg-surface-container-low shadow-sm">
                                <img id="profileImagePreview" src="/images/default-avatar.svg" onerror="this.onerror=null; this.src='/images/default-avatar.svg';" alt="Profile Photo" class="w-full h-full object-cover">
                            </div>
                        </div>
                        
                        <input type="file" id="profilePhotoInput" accept="image/*" class="hidden">
                        <button type="button" onclick="document.getElementById('profilePhotoInput').click()" class="w-full bg-secondary-container text-on-secondary-container hover:bg-secondary-fixed-dim px-4 py-2 rounded-lg font-label-lg transition-colors flex items-center justify-center gap-2 mb-3 shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">photo_camera</span>
                            Select Photo
                        </button>
                        <p class="text-[11px] text-on-surface-variant/70 text-center">Optional: Upload a photo for the doctor's profile.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/admin/registerDoctor.js"></script>
</body>
</html>
