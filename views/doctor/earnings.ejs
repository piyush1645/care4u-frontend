<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Doctor Earnings & Invoices | MedPortal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script src="/js/doctor/tailwind-config.js"></script>
    <link rel="stylesheet" href="/css/doctor/common.css">
</head>
<body class="bg-background text-on-surface flex h-screen overflow-hidden">
    <!-- Side Navigation Bar -->
    <%- include("partials/leftNavBar.ejs") %>
    
    <!-- Main Wrapper -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden w-full">
        <!-- Top Navigation Bar -->
        <%- include("partials/topHeader.ejs") %>
        
        <!-- Main Content Area -->
        <main class="p-4 lg:p-xl flex-1 overflow-y-auto">
            <!-- Header Section -->
            <header class="mb-lg flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                    <h2 class="font-display-lg text-display-lg text-primary mb-1">Earnings & Invoices</h2>
                    <p class="font-body-md text-on-surface-variant">View billing transactions, calculate taxation deductions, and export reports.</p>
                </div>
            </header>

            <!-- Earnings Bento Cards -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-lg mb-xl">
                <!-- Total Gross Earnings Card -->
                <div class="bg-surface-container-lowest p-lg rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)] border-l-4 border-[#002868]">
                    <div class="flex items-center justify-between mb-xs">
                        <p class="text-label-sm text-on-surface-variant">Gross Earnings</p>
                        <span class="material-symbols-outlined text-[#002868] text-[20px]">account_balance_wallet</span>
                    </div>
                    <h3 class="text-display-md font-display-md text-primary">₹<%= totalEarnings %></h3>
                    <div class="mt-md flex items-center text-emerald-600 text-label-sm font-semibold">
                        <span class="material-symbols-outlined text-[16px] mr-1">trending_up</span> 
                        Total consultation fees
                    </div>
                </div>

                <!-- Total Tax Deducted Card -->
                <div class="bg-surface-container-lowest p-lg rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)] border-l-4 border-amber-500">
                    <div class="flex items-center justify-between mb-xs">
                        <p class="text-label-sm text-on-surface-variant">Tax charges</p>
                        <span class="material-symbols-outlined text-amber-500 text-[20px]">percent</span>
                    </div>
                    <h3 class="text-display-md font-display-md text-amber-600">₹<%= totalTax %></h3>
                    <div class="mt-md flex items-center text-slate-500 text-label-sm">
                        <span class="material-symbols-outlined text-[16px] mr-1">info</span> 
                        Deducted at source
                    </div>
                </div>

                <!-- Net Payout Card -->
                <div class="bg-surface-container-lowest p-lg rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)] border-l-4 border-emerald-500">
                    <div class="flex items-center justify-between mb-xs">
                        <p class="text-label-sm text-on-surface-variant">Total Volume</p>
                        <span class="material-symbols-outlined text-emerald-500 text-[20px]">payments</span>
                    </div>
                    <h3 class="text-display-md font-display-md text-emerald-700">₹<%= totalAmount %></h3>
                    <div class="mt-md flex items-center text-slate-500 text-label-sm">
                        <span class="material-symbols-outlined text-[16px] mr-1">add_moderator</span> 
                        Inclusive of all taxes
                    </div>
                </div>

                <!-- Total Consultations Card -->
                <div class="bg-surface-container-lowest p-lg rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)] border-l-4 border-blue-500">
                    <div class="flex items-center justify-between mb-xs">
                        <p class="text-label-sm text-on-surface-variant">Consultations</p>
                        <span class="material-symbols-outlined text-blue-500 text-[20px]">diversity_1</span>
                    </div>
                    <h3 class="text-display-md font-display-md text-blue-700"><%= invoices.length %></h3>
                    <div class="mt-md flex items-center text-slate-500 text-label-sm">
                        <span class="material-symbols-outlined text-[16px] mr-1">check_circle</span> 
                        Settled invoices
                    </div>
                </div>
            </div>

            <!-- Export & Filters Control Section -->
            <section class="bg-surface-container-lowest rounded-xl p-lg shadow-[0px_4px_12px_rgba(0,0,0,0.03)] mb-xl">
                <h4 class="font-headline-sm text-headline-sm text-primary mb-md flex items-center gap-2">
                    <span class="material-symbols-outlined text-[20px]">download</span>
                    Monthly Billing Export
                </h4>
                
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
                    <div class="flex-1 max-w-sm">
                        <label for="monthSelect" class="block text-xs font-semibold text-on-surface-variant mb-1">Select Statement Month</label>
                        <select id="monthSelect" class="w-full rounded-lg border-outline-variant/60 bg-surface-container-lowest text-label-lg py-2 focus:ring-1 focus:ring-primary focus:border-primary">
                            <% if (months && months.length > 0) { %>
                                <% months.forEach(m => { %>
                                    <option value="<%= m.key %>"><%= m.label %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="">No transactions recorded</option>
                            <% } %>
                        </select>
                    </div>
                    
                    <div class="flex items-end">
                        <button onclick="downloadMonthlyInvoice()" class="w-full sm:w-auto bg-[#002868] text-white px-6 py-2.5 rounded-lg font-label-lg active:scale-95 transition-transform hover:shadow-lg flex items-center justify-center gap-2">
                            <span class="material-symbols-outlined text-[18px]">print</span>
                            Print Monthly Summary
                        </button>
                    </div>
                </div>
            </section>

            <!-- Detailed Transactions Table -->
            <section class="bg-surface-container-lowest rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.03)] overflow-hidden">
                <div class="p-lg border-b border-outline-variant/30 flex justify-between items-center">
                    <h4 class="font-headline-sm text-headline-sm text-primary flex items-center gap-2">
                        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                        Transaction History
                    </h4>
                </div>
                
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse text-left">
                        <thead>
                            <tr class="bg-surface-container-low/50 text-label-md text-on-surface-variant border-b border-outline-variant/30">
                                <th class="p-4 font-semibold">Invoice ID</th>
                                <th class="p-4 font-semibold">Date</th>
                                <th class="p-4 font-semibold">Patient Name</th>
                                <th class="p-4 font-semibold">Consultation Fee</th>
                                <th class="p-4 font-semibold">Tax charges</th>
                                <th class="p-4 font-semibold">Total Amount</th>
                                <th class="p-4 font-semibold">Paid By</th>
                                <th class="p-4 font-semibold text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-outline-variant/20 text-body-md text-on-surface">
                            <% if (invoices && invoices.length > 0) { %>
                                <% invoices.forEach(inv => { %>
                                    <tr class="hover:bg-slate-50/50 transition-colors">
                                        <td class="p-4 font-mono text-xs text-on-surface-variant font-semibold">#<%= inv.id %></td>
                                        <td class="p-4 font-semibold"><%= inv.date %></td>
                                        <td class="p-4"><%= inv.patientName %></td>
                                        <td class="p-4 font-medium text-primary">₹<%= inv.consultationFees %></td>
                                        <td class="p-4 text-on-surface-variant/80">₹<%= inv.taxCharges %></td>
                                        <td class="p-4 font-bold text-[#002868]">₹<%= inv.totalAmount %></td>
                                        <td class="p-4">
                                            <span class="px-2 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-slate-700">
                                                <%= inv.paidBy %>
                                            </span>
                                        </td>
                                        <td class="p-4 text-right">
                                            <a href="/doctor/earnings/invoice/<%= inv.id %>" target="_blank" class="inline-flex items-center gap-1 text-[11px] px-3 py-1.5 bg-[#002868]/5 hover:bg-[#002868]/10 text-[#002868] rounded-lg font-bold transition-all border border-[#002868]/15 shadow-sm">
                                                <span class="material-symbols-outlined text-[14px]">visibility</span> View Invoice
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="8" class="p-8 text-center text-on-surface-variant italic">
                                        No billing invoices found.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <script src="/js/doctor/earnings.js"></script>
</body>
</html>
