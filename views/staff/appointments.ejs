<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <title>Staff Appointments | Care4U</title>
    <%- include('partials/head') %>
</head>
<body class="bg-[#F4F5F7] text-on-surface">

    <%- include('partials/sidebar') %>
    <%- include('partials/topheader') %>

    <!-- ═══════════════════════════ MAIN ═══════════════════════════ -->
    <main class="ml-0 lg:ml-64 p-md max-w-full overflow-x-hidden">
        <div class="flex flex-col md:flex-row md:items-center justify-between mb-lg gap-sm">
            <div>
                <h2 class="text-2xl font-bold text-on-surface">Appointments</h2>
                <p class="text-sm text-on-surface-variant">Search, filter and manage all appointments</p>
            </div>
            <a href="/staff/patients" class="flex items-center gap-2 bg-primary text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-primary/90 transition-all active:scale-95">
                <span class="material-symbols-outlined text-[18px]">add</span> New Appointment
            </a>
        </div>

        <!-- Filters -->
        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md mb-md">
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Date</label>
                    <input id="apptFilterDate" type="date" value="<%= new Date().toISOString().split('T')[0] %>"
                        class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Doctor</label>
                    <select id="apptFilterDoctor" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm">
                        <option value="">All Doctors</option>
                        <% doctors.forEach(function(doc) { %>
                            <option value="<%= doc.id %>"><%= doc.fullName || (doc.firstName + ' ' + doc.lastName) %></option>
                        <% }); %>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-on-surface-variant mb-1">Status</label>
                    <select id="apptFilterStatus" class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm">
                        <option value="">All Statuses</option>
                        <option value="BOOKED">Booked</option>
                        <option value="COMPLETED">Completed</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>
                </div>
                <div class="flex items-end">
                    <button onclick="loadAppointments()"
                        class="w-full bg-primary text-white py-2 rounded-lg text-sm font-semibold hover:bg-primary/90 transition-all flex items-center justify-center gap-1">
                        <span class="material-symbols-outlined text-[16px]">search</span> Search
                    </button>
                </div>
            </div>
        </div>

        <!-- Appointments Table -->
        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
            <div class="p-md border-b border-outline-variant/30 flex items-center justify-between">
                <p class="text-sm font-semibold text-on-surface">Results <span id="apptResultCount" class="text-on-surface-variant font-normal"></span></p>
                <div id="apptLoadingSpinner" class="hidden"><div class="spinner"></div></div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left">
                    <thead class="bg-surface-container-low">
                        <tr>
                            <th class="p-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Patient</th>
                            <th class="p-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Doctor</th>
                            <th class="p-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Date & Time</th>
                            <th class="p-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Status</th>
                            <th class="p-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Payment</th>
                            <th class="p-md text-xs font-semibold text-on-surface-variant uppercase tracking-wider">Action</th>
                        </tr>
                    </thead>
                    <tbody id="apptTableBody" class="divide-y divide-outline-variant/30">
                        <tr>
                            <td colspan="6" class="p-lg text-center text-on-surface-variant text-sm">
                                Use the filters above and click <strong>Search</strong> to load appointments.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
    
    <!-- Reschedule Modal -->
    <div id="rescheduleModal" class="fixed inset-0 bg-slate-900/50 z-50 hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-xl shadow-xl w-full max-w-lg my-8">
            <div class="p-md border-b border-outline-variant/30 flex justify-between items-center sticky top-0 bg-white rounded-t-xl z-10">
                <h3 class="text-lg font-bold text-on-surface">Reschedule Appointment</h3>
                <button onclick="closeRescheduleModal()" class="text-on-surface-variant hover:text-on-surface">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="p-md">
                <form id="rescheduleForm" onsubmit="submitReschedule(event)" class="space-y-4">
                    <input type="hidden" id="rescheduleApptId" />
                    <input type="hidden" id="rescheduleDoctorId" />
                    
                    <div class="flex gap-3">
                        <div class="flex-1">
                            <label class="block text-xs font-semibold text-on-surface-variant mb-1">Select New Date</label>
                            <input type="date" id="rescheduleDate" required class="w-full border border-outline-variant rounded-lg px-3 py-2 text-sm" />
                        </div>
                        <div class="flex items-end">
                            <button type="button" onclick="fetchRescheduleSlots()" class="px-4 py-2 bg-secondary text-white rounded-lg text-sm font-semibold hover:bg-secondary/90 transition-all shadow-sm">Check Slots</button>
                        </div>
                    </div>

                    <!-- Slot grid -->
                    <div id="rescheduleSlotSection" class="hidden bg-surface-container/20 rounded-xl border border-outline-variant/30 p-md space-y-3">
                        <h4 class="font-bold text-on-surface text-sm">Available Slots</h4>
                        
                        <div id="rescheduleSlotsLoading" class="hidden text-center py-6 text-on-surface-variant text-sm flex flex-col items-center">
                            Loading slots...
                        </div>
                        
                        <div id="rescheduleSlotsEmpty" class="hidden text-center py-6 text-on-surface-variant text-sm">
                            <span id="rescheduleSlotsEmptyMsg">No slots available on this date.</span>
                        </div>
                        
                        <div id="rescheduleSlotsContainer" class="space-y-4">
                            <!-- Morning Slots -->
                            <div id="rescheduleMorningSection" class="hidden space-y-2">
                                <p class="text-[11px] font-bold text-outline uppercase tracking-wider flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs text-amber-500">light_mode</span>
                                    Morning Slots
                                </p>
                                <div id="rescheduleMorningGrid" class="grid grid-cols-4 gap-2"></div>
                            </div>
                            <!-- Evening Slots -->
                            <div id="rescheduleEveningSection" class="hidden space-y-2">
                                <p class="text-[11px] font-bold text-outline uppercase tracking-wider flex items-center gap-1">
                                    <span class="material-symbols-outlined text-xs text-indigo-500">dark_mode</span>
                                    Evening Slots
                                </p>
                                <div id="rescheduleEveningGrid" class="grid grid-cols-4 gap-2"></div>
                            </div>
                        </div>
                    </div>

                    <div id="rescheduleError" class="hidden text-sm text-red-600 bg-red-50 p-2 rounded border border-red-200"></div>
                    
                    <div class="flex justify-end gap-3 pt-4 border-t border-outline-variant/30 mt-4">
                        <button type="button" onclick="closeRescheduleModal()" class="px-4 py-2 text-sm border border-outline-variant rounded-lg font-medium hover:bg-surface-container">Cancel</button>
                        <button type="submit" id="rescheduleSubmitBtn" disabled class="px-5 py-2 text-sm bg-primary text-white rounded-lg font-bold hover:bg-primary/90 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed transition-all">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    
    <script src="/js/staff/appointments.js"></script>
</body>
</html>
