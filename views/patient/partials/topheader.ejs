<header class="h-12 bg-white border-b border-slate-200 flex items-center justify-between px-4 lg:px-8 z-30 shrink-0">
    <!-- Mobile Menu + Page Title -->
    <div class="flex items-center gap-3">
        <button onclick="toggleSidebar()"
            class="lg:hidden p-2 text-slate-500 hover:text-[#002868] rounded-lg">
            <span class="material-symbols-outlined">menu</span>
        </button>
        <h1 class="font-bold text-lg text-slate-800 hidden sm:block" id="pageTitle">Patient Portal</h1>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-2">
        <div class="h-6 w-px bg-slate-200 mx-1 hidden sm:block"></div>
        <button onclick="window.location.href='/patient/profile'"
            class="flex items-center gap-2 hover:bg-slate-50 px-2 py-1.5 rounded-xl border border-transparent hover:border-slate-200 transition-all">
            <div id="headerAvatarWrap" class="w-8 h-8 rounded-full bg-blue-50 text-[#002868] flex items-center justify-center overflow-hidden">
                <% if (locals.patient && patient.profilePhoto) { %>
                    <img src="<%= patient.profilePhoto %>" onerror="this.onerror=null; this.src='/images/default-avatar.svg';" class="w-full h-full object-cover rounded-full" />
                <% } else { %>
                    <span class="material-symbols-outlined text-[18px]">person</span>
                <% } %>
            </div>
            <span id="headerPatientName" class="text-sm font-medium text-slate-700 hidden sm:block">
                <%= locals.patient ? patient.firstName : 'Patient' %>
            </span>
        </button>
    </div>
</header>
