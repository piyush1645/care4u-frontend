<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Forgot Password - MedCentral Clinician Portal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script id="tailwind-config" src="/js/auth/tailwind-config.js"></script>
    <link rel="stylesheet" href="/css/auth/forgotPassword.css">
</head>

<body class="min-h-screen flex items-center justify-center p-margin-mobile md:p-0">
    <!-- Atmospheric Background Element -->
    <div class="fixed inset-0 z-[-1] overflow-hidden opacity-40">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary/5 blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-secondary/5 blur-[120px]"></div>
    </div>
    <!-- Main Forgot Password Container -->
    <main class="w-full max-w-[440px] animate-in fade-in slide-in-from-bottom-4 duration-700">
        <!-- Identity Branding (Center Aligned) -->
        <div class="flex flex-col items-center mb-xl">
            <div class="w-16 h-16 bg-primary-container rounded-xl flex items-center justify-center mb-md shadow-sm">
                <span class="material-symbols-outlined text-[40px] text-on-primary-container"
                    data-icon="medical_services">medical_services</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-primary tracking-tight">MedCentral</h1>
            <p class="font-label-sm text-label-sm text-outline uppercase tracking-widest">Clinical Portal</p>
        </div>
        <!-- Reset Card -->
        <div class="tonal-layer-1 rounded-xl p-xl border border-surface-variant/50">
            <div class="text-center mb-lg">
                <h2 class="font-headline-sm text-headline-sm text-on-surface mb-xs">Forgot Password?</h2>
                <p class="font-body-md text-body-md text-on-surface-variant px-sm">
                    Enter your registered email address to receive a verification code.
                </p>
            </div>
            <form action="#" class="space-y-lg">
                <!-- Email Input Field -->
                <div class="space-y-xs">
                    <label class="font-label-lg text-label-lg text-on-surface-variant ml-1" for="email">Email
                        Address</label>
                    <div class="relative group">
                        <div
                            class="absolute inset-y-0 left-0 pl-md flex items-center pointer-events-none text-outline group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]" data-icon="mail">mail</span>
                        </div>
                        <input
                            class="block w-full pl-11 pr-md py-3 bg-surface-container-low border-0 focus:ring-2 focus:ring-primary rounded-lg font-body-md text-on-surface transition-all placeholder:text-outline/60"
                            id="email" name="email" placeholder="clinician@medcentral.org" required="" type="email" />
                    </div>
                </div>
                <!-- Primary Action Button -->
                <button
                    class="w-full bg-primary hover:bg-primary/90 text-on-primary font-label-lg text-label-lg py-3.5 px-xl rounded-lg shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-sm group"
                    type="submit">
                    Send Reset Code
                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform"
                        data-icon="arrow_forward">arrow_forward</span>
                </button>
            </form>
            <!-- Back to Login Link -->
            <div class="mt-xl text-center">
                <a class="inline-flex items-center gap-xs font-label-lg text-label-lg text-primary hover:text-primary-container transition-colors group"
                    href="/auth/login">
                    <span class="material-symbols-outlined text-[18px]" data-icon="chevron_left">chevron_left</span>
                    Back to Login
                </a>
            </div>
        </div>
        <!-- Security Badge/Footer -->
        <footer class="mt-xl text-center space-y-md">
            <div class="flex items-center justify-center gap-md">
                <div class="flex items-center gap-xs text-secondary font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[16px]"
                        data-icon="enhanced_encryption">enhanced_encryption</span>
                    HIPAA Compliant
                </div>
                <div class="w-1 h-1 bg-outline-variant rounded-full"></div>
                <div class="flex items-center gap-xs text-outline font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[16px]" data-icon="verified_user">verified_user</span>
                    Secure Session
                </div>
            </div>
            <p class="font-label-sm text-label-sm text-outline-variant max-w-[300px] mx-auto">
                © 2024 MedCentral Healthcare Systems. Confidential Clinician Portal.
            </p>
        </footer>
    </main>
    <!-- Subtle Visual Motif (Bottom Right) -->
    <div class="fixed bottom-0 right-0 p-xl opacity-10 pointer-events-none hidden md:block">
        <span class="material-symbols-outlined text-[120px] text-primary" data-icon="monitor_heart">monitor_heart</span>
    </div>

    <script src="/js/auth/forgotPassword.js"></script>
</body>

</html>