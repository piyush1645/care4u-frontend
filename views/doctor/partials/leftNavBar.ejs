<!-- Mobile Overlay -->
<div id="mobile-overlay" class="fixed inset-0 bg-slate-900/50 z-40 hidden lg:hidden transition-opacity" onclick="toggleSidebar()"></div>

<aside id="sidebar"
    class="fixed inset-y-0 left-0 z-50 w-64 bg-white text-slate-700 flex flex-col transition-transform duration-300 transform -translate-x-full lg:translate-x-0 lg:static lg:flex-shrink-0 shadow-2xl lg:shadow-none border-r border-slate-100">
    
    <!-- Logo -->
    <div class="h-20 flex items-center px-6 shrink-0 mt-2 border-b border-slate-100 mb-2">
        <div class="w-10 h-10 bg-[#002868] text-white rounded-lg flex items-center justify-center mr-3 shrink-0 shadow-sm">
            <span class="material-symbols-outlined text-[22px]">medical_services</span>
        </div>
        <div class="flex flex-col">
            <h1 class="font-bold text-[#002868] text-[18px] leading-tight">MediCare</h1>
            <p class="text-[11px] text-slate-500 font-medium">Doctor Portal</p>
        </div>
    </div>

    <% if (typeof user !== 'undefined' && user && (user.role === 'ADMIN' || user.role === 'SUPER_ADMIN')) { %>
        <!-- Back to Admin Dashboard -->
        <div class="px-4 py-2 border-b border-slate-100 bg-slate-50/50">
            <a href="<%= user.role === 'ADMIN' ? '/admin/dashboard' : '/superadmin/dashboard' %>"
                class="flex items-center gap-3 px-3 py-2 rounded-lg bg-[#002868]/10 hover:bg-[#002868]/20 transition-all text-[#002868] font-semibold text-[13px] border border-[#002868]/10 shadow-sm justify-center">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                <span>Exit Doctor View</span>
            </a>
        </div>
    <% } %>

    <!-- Navigation -->
    <nav class="flex-1 overflow-y-auto sidebar-scroll py-2 px-4 space-y-1">
        <% const queryStr = (typeof doctorId !== 'undefined' && doctorId) ? '?doctorId=' + doctorId : ''; %>

        <!-- Active link -->
        <a href="/doctor/dashboard<%= queryStr %>" class="flex items-center gap-4 px-4 py-3 rounded-lg bg-[#002868] text-white font-medium mb-1 shadow-sm">
            <span class="material-symbols-outlined text-[20px]">grid_view</span> <span class="text-[14px]">Dashboard</span>
        </a>
        
        <a href="/doctor/appointments<%= queryStr %>"
            class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors text-slate-600 hover:text-[#002868] font-medium mb-1">
            <span class="material-symbols-outlined text-[20px]">event</span> <span class="text-[14px]">Upcoming Appointments</span>
        </a>
        
        <a href="/doctor/all-appointments<%= queryStr %>"
            class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors text-slate-600 hover:text-[#002868] font-medium mb-1">
            <span class="material-symbols-outlined text-[20px]">calendar_month</span> <span class="text-[14px]">All Appointments</span>
        </a>
        <a href="/doctor/schedule<%= queryStr %>"
            class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors text-slate-600 hover:text-[#002868] font-medium mb-1">
            <span class="material-symbols-outlined text-[20px]">schedule</span> <span class="text-[14px]">Schedule</span>
        </a>
        
        <a href="/doctor/leaves<%= queryStr %>"
            class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors text-slate-600 hover:text-[#002868] font-medium mb-1">
            <span class="material-symbols-outlined text-[20px]">event_busy</span> <span class="text-[14px]">Leaves</span>
        </a>

        <a href="/doctor/earnings<%= queryStr %>"
            class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors text-slate-600 hover:text-[#002868] font-medium mb-1">
            <span class="material-symbols-outlined text-[20px]">payments</span> <span class="text-[14px]">Earnings & Invoices</span>
        </a>
        
        <a href="/doctor/profile<%= queryStr %>"
            class="flex items-center gap-4 px-4 py-3 rounded-lg hover:bg-slate-50 transition-colors text-slate-600 hover:text-[#002868] font-medium mb-1">
            <span class="material-symbols-outlined text-[20px]">person</span> <span class="text-[14px]">Profile</span>
        </a>

    </nav>

    <!-- Bottom Actions -->
    <div class="p-4 shrink-0 border-t border-slate-100">
        <a href="/logout"
            class="flex items-center gap-4 px-4 py-2.5 rounded-lg hover:bg-red-50 transition-colors text-[#dc2626] font-medium">
            <span class="material-symbols-outlined text-[20px]">logout</span> <span class="text-[14px]">Logout</span>
        </a>
    </div>

    <!-- Active State Logic & Mobile Toggle -->
    <script src="/js/doctor/sidebar.js"></script>
</aside>