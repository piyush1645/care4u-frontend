<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Doctor Details | Care4U</title>
    <%- include('partials/head') %>
</head>

<body class="bg-[#F4F5F7] text-on-surface flex h-screen overflow-hidden">

    <%- include('partials/sidebar') %>

        <div class="flex-1 flex flex-col h-screen overflow-hidden">
            <%- include('partials/topheader') %>

                <main class="flex-1 overflow-y-auto p-md max-w-full overflow-x-hidden ml-0 lg:ml-64">
                    <div class="max-w-6xl mx-auto space-y-6 pb-lg">

                        <!-- Back link & Patient info -->
                        <div class="flex items-center justify-between">
                            <a href="/staff/doctors"
                                class="inline-flex items-center gap-1 text-sm text-on-surface-variant hover:text-primary transition-colors">
                                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                                Back to Doctors
                            </a>
                            <div id="bookingForPatientBanner"
                                class="hidden bg-primary/10 text-primary px-3 py-1.5 rounded-lg text-sm font-semibold border border-primary/20">
                                Booking for: <span id="bookingPatientName"></span>
                            </div>
                        </div>

                        <% if (!locals.doctor) { %>
                            <div class="flex flex-col items-center justify-center py-24 text-on-surface-variant">
                                <span class="material-symbols-outlined text-5xl mb-3 opacity-30">person_off</span>
                                <p class="font-bold text-on-surface text-lg">Doctor not found</p>
                                <a href="/staff/doctors"
                                    class="mt-4 bg-primary text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-primary/90">Back
                                    to Search</a>
                            </div>
                            <% } else { %>

                                <!-- Booking error -->
                                <div id="bookingError"
                                    class="hidden p-4 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm font-medium">
                                </div>

                                <!-- Main content -->
                                <div class="space-y-6">

                                    <!-- Doctor header card -->
                                    <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md">
                                        <div class="flex flex-col sm:flex-row gap-6 items-start">
                                            <img src="<%= doctor.profilePhoto || '/images/default-avatar.svg' %>"
                                                onerror="this.onerror=null; this.src='/images/default-avatar.svg';"
                                                alt="<%= doctor.fullName || ('Dr. ' + (doctor.firstName || '') + ' ' + (doctor.lastName || '')) %>"
                                                class="w-28 h-28 rounded-xl object-cover border border-outline-variant/30 shadow-sm shrink-0" />
                                            <div class="flex-1 space-y-3">
                                                <div>
                                                    <div class="flex flex-wrap gap-1.5 mb-2">
                                                        <% /* Backend controller maps speciality[] -> specialities
                                                              (string[]) and schedule[] -> schedules */
                                                            const specs = Array.isArray(doctor.specialities) ?
                                                            doctor.specialities
                                                            : (doctor.speciality ? doctor.speciality.map(s => s.name) :
                                                            []);
                                                            %>
                                                            <% specs.forEach(s=> { %>
                                                                <span
                                                                    class="px-2 py-0.5 bg-primary/10 text-primary text-[11px] font-bold rounded-full uppercase">
                                                                    <%= s %>
                                                                </span>
                                                                <% }) %>
                                                    </div>
                                                    <h2 class="text-2xl font-bold text-on-surface">
                                                        <% if (doctor.fullName) { %>
                                                            <%= doctor.fullName %>
                                                                <% } else { %>
                                                                    Dr. <%= doctor.firstName %>
                                                                        <%= doctor.middleName ? doctor.middleName + ' '
                                                                            : '' %>
                                                                            <%= doctor.lastName %>
                                                                                <% } %>
                                                    </h2>
                                                    <% if (doctor.rating) { %>
                                                        <p
                                                            class="text-sm text-emerald-600 font-medium mt-0.5 flex items-center gap-1">
                                                            <span
                                                                class="material-symbols-outlined text-[16px] text-emerald-500 fill-current">star</span>
                                                            <%= doctor.rating.average || '0' %> (<%=
                                                                    doctor.rating.totalReviews || '0' %> reviews)
                                                        </p>
                                                        <% } %>
                                                </div>
                                                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                                    <div
                                                        class="bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-center">
                                                        <p class="text-[10px] text-outline font-semibold uppercase">
                                                            Experience</p>
                                                        <p class="text-sm font-bold text-on-surface mt-0.5">
                                                            <%= doctor.expereince || doctor.experience || '0' %> yrs
                                                        </p>
                                                    </div>
                                                    <div
                                                        class="bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-center">
                                                        <p class="text-[10px] text-outline font-semibold uppercase">
                                                            Charges</p>
                                                        <p class="text-sm font-bold text-on-surface mt-0.5">₹<%=
                                                                doctor.charges || '0' %>
                                                        </p>
                                                    </div>
                                                    <div
                                                        class="bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-center">
                                                        <p class="text-[10px] text-outline font-semibold uppercase">Slot
                                                        </p>
                                                        <p class="text-sm font-bold text-on-surface mt-0.5">
                                                            <%= doctor.slotDuration || '0' %> mins
                                                        </p>
                                                    </div>
                                                    <div
                                                        class="bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-3 text-center">
                                                        <p class="text-[10px] text-outline font-semibold uppercase">
                                                            Gender</p>
                                                        <p class="text-sm font-bold text-on-surface mt-0.5">
                                                            <%= doctor.gender || 'N/A' %>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Two column: Info + Booking -->
                                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                                        <!-- Left: Details -->
                                        <div class="lg:col-span-2 space-y-5">
                                            <!-- Hospital -->
                                            <div
                                                class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md">
                                                <h3 class="font-bold text-on-surface mb-3 flex items-center gap-2">
                                                    <span
                                                        class="material-symbols-outlined text-primary text-[20px]">local_hospital</span>
                                                    Hospital
                                                </h3>
                                                <p class="font-semibold text-on-surface">
                                                    <%= doctor.hospital?.branchName || 'N/A' %>
                                                </p>
                                                <p class="text-sm text-on-surface-variant mt-1">
                                                    <% if (doctor.hospital && doctor.hospital.address) { %>
                                                        <%= [doctor.hospital.address.addressLine1,
                                                            doctor.hospital.address.city,
                                                            doctor.hospital.address.state].filter(Boolean).join(', ') %>
                                    <% } %>
                                </p>
                            </div>

                            <!-- Schedule -->
                            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md">
                                <h3 class="font-bold text-on-surface mb-3 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">schedule</span>
                                    Availability
                                </h3>
                                <div class="space-y-3">
                                    <%
                                        // Backend controller maps schedule[] -> schedules (array of schedule objects)
                                        const doctorSchedules = Array.isArray(doctor.schedules) ? doctor.schedules
                                                              : (Array.isArray(doctor.schedule) ? doctor.schedule : []);
                                    %>
                                    <% if (doctorSchedules.length > 0) { %>
                                        <% doctorSchedules.forEach(sch => { %>
                                            <div class="flex items-start gap-2.5 bg-surface-container-low p-3 rounded-lg border border-outline-variant/30">
                                                <span class="material-symbols-outlined text-outline text-[18px] mt-0.5">calendar_month</span>
                                                <div>
                                                    <p class="font-semibold text-on-surface text-sm">Working Days: <%= sch.workingDays %></p>
                                                    <% if (sch.morningStartTime && sch.morningEndTime) { %>
                                                        <p class="text-xs text-on-surface-variant mt-1">Morning: <%= new Date(sch.morningStartTime).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true }) %> – <%= new Date(sch.morningEndTime).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true }) %></p>
                                                    <% } %>
                                                    <% if (sch.eveningStartTime && sch.eveningEndTime) { %>
                                                        <p class="text-xs text-on-surface-variant">Evening: <%= new Date(sch.eveningStartTime).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true }) %> – <%= new Date(sch.eveningEndTime).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true }) %></p>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-sm text-on-surface-variant italic">No working hours configured.</p>
                                    <% } %>
                                </div>
                            </div>
                            <!-- Degrees / Education -->
                            <% if (doctor.degrees && doctor.degrees.length > 0) { %>
                            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md">
                                <h3 class="font-bold text-on-surface mb-3 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">school</span>
                                    Education
                                </h3>
                                <div class="space-y-3">
                                    <% doctor.degrees.forEach(deg => { %>
                                        <div class="flex items-start gap-3 bg-surface-container-low p-3 rounded-lg border border-outline-variant/30">
                                            <span class="material-symbols-outlined text-outline text-[18px] mt-0.5">verified</span>
                                            <div>
                                                <p class="font-semibold text-on-surface text-sm"><%= deg.courseName %> (<%= deg.abbreviation %>)</p>
                                                <p class="text-xs text-on-surface-variant mt-0.5"><%= deg.institution %>, <%= deg.passingYear %></p>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                            <% } %>

                            <!-- Languages -->
                            <% if (doctor.preferedLanguages) { %>
                            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md">
                                <h3 class="font-bold text-on-surface mb-3 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">translate</span>
                                    Languages
                                </h3>
                                <p class="text-sm text-on-surface-variant"><%= doctor.preferedLanguages %></p>
                            </div>
                            <% } %>

                            <!-- Reviews -->
                            <% if (doctor.reviews && doctor.reviews.length > 0) { %>
                            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md">
                                <h3 class="font-bold text-on-surface mb-3 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">star</span>
                                    Patient Reviews (<%= doctor.reviews.length %>)
                                </h3>
                                <div class="space-y-3">
                                    <% doctor.reviews.slice(0, 5).forEach(rev => { %>
                                        <div class="bg-surface-container-low p-3 rounded-lg border border-outline-variant/30">
                                            <div class="flex items-center justify-between mb-1">
                                                <p class="text-sm font-semibold text-on-surface"><%= rev.patient ? rev.patient.firstName + ' ' + (rev.patient.lastName || '') : 'Anonymous' %></p>
                                                <div class="flex items-center gap-1">
                                                    <span
                                                        class="material-symbols-outlined text-amber-500 text-[14px]">star</span>
                                                    <span class="text-xs font-bold text-on-surface">
                                                        <%= rev.rating %>
                                                    </span>
                                                </div>
                                            </div>
                                            <% if (rev.review) { %>
                                                <p class="text-xs text-on-surface-variant">
                                                    <%= rev.review %>
                                                </p>
                                                <% } %>
                                        </div>
                                        <% }) %>
                                    </div>
                                </div>
                                <% } %>
                    </div>

                    <!-- Right: Booking Flow (sticky) -->
                    <div class="lg:sticky lg:top-6 h-fit space-y-4">

                        <!-- Pick a date -->
                        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md space-y-4">
                            <h3 class="font-bold text-on-surface pb-3 border-b border-outline-variant/30">Select Date &
                                Time</h3>

                            <div class="flex flex-col gap-1.5">
                                <label for="slotDate"
                                    class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Select
                                    Date</label>
                                <input id="slotDate" type="date" min="<%= new Date().toISOString().split('T')[0] %>"
                                    value="<%= new Date().toISOString().split('T')[0] %>"
                                    class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                            </div>

                            <button id="checkSlotsBtn" onclick="fetchSlots()"
                                class="w-full bg-surface-container text-on-surface py-2.5 rounded-lg text-sm font-semibold hover:bg-outline-variant/30 transition-colors flex items-center justify-center gap-2">
                                <span class="material-symbols-outlined text-[18px]">calendar_view_week</span>
                                View Available Slots
                            </button>
                        </div>

                        <!-- Slot grid -->
                        <div id="slotSection"
                            class="hidden bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md space-y-3">
                            <div class="flex items-center justify-between pb-3 border-b border-outline-variant/30">
                                <h4 class="font-bold text-on-surface text-sm">Available Slots</h4>
                            </div>

                            <div id="slotsLoading"
                                class="hidden text-center py-6 text-on-surface-variant text-sm flex flex-col items-center">
                                <div class="spinner mb-2"></div>
                                Loading slots...
                            </div>

                            <div id="slotsEmpty" class="hidden text-center py-6 text-on-surface-variant text-sm">
                                <span class="material-symbols-outlined text-3xl block mb-2 opacity-40">event_busy</span>
                                <span id="slotsEmptyMsg">No slots available on this date.</span>
                            </div>

                            <div id="slotsContainer" class="space-y-4">
                                <!-- Morning Slots -->
                                <div id="morningSlotSection" class="hidden space-y-2">
                                    <p
                                        class="text-[11px] font-bold text-outline uppercase tracking-wider flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs text-amber-500">light_mode</span>
                                        <span id="morningSlotLabel">Morning Slots</span>
                                    </p>
                                    <div id="morningSlotsGrid" class="grid grid-cols-3 gap-2"></div>
                                </div>
                                <!-- Evening Slots -->
                                <div id="eveningSlotSection" class="hidden space-y-2">
                                    <p
                                        class="text-[11px] font-bold text-outline uppercase tracking-wider flex items-center gap-1">
                                        <span class="material-symbols-outlined text-xs text-indigo-500">dark_mode</span>
                                        <span id="eveningSlotLabel">Evening Slots</span>
                                    </p>
                                    <div id="eveningSlotsGrid" class="grid grid-cols-3 gap-2"></div>
                                </div>
                            </div>

                            <button id="proceedBtn" onclick="proceedToPayment()" disabled
                                class="w-full bg-primary text-white py-2.5 rounded-lg text-sm font-semibold transition-all disabled:opacity-40 disabled:cursor-not-allowed hover:bg-primary/90 mt-2">
                                Proceed to Payment
                            </button>
                        </div>

                    </div>
        </div>

        </div>
        <% } %>
            </div>
            </main>
            </div>

            <script>
                const doctorId = "<%= locals.doctor ? doctor.id : '' %>";
                const doctorName = "<%= locals.doctor ? (doctor.fullName || ('Dr. ' + (doctor.firstName || '') + ' ' + (doctor.lastName || ''))) : '' %>";
                const doctorCharges = <%= locals.doctor ? (doctor.charges || 0) : 0 %>;
            </script>
            <script src="/js/staff/doctorDetail.js"></script>
</body>

</html>