    <!DOCTYPE html>

    <html class="light" lang="en">

    <head>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <title>Dr. <%= doctor.firstName %> <%= doctor.lastName %> | MedPortal Profile</title>
        <link rel="stylesheet" href="/css/output.css">
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap" rel="stylesheet" />
        <link
            href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
            rel="stylesheet" />
        <link rel="stylesheet" href="/css/admin/common.css">
        <link rel="stylesheet" href="/css/admin/modal.css">
        <style>
            .bento-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 24px;
            }
        </style>
    </head>

    <body class="bg-background text-on-surface h-screen overflow-hidden flex">
    
        <!-- Sidebar -->
        <%- include("../partial/navBar.ejs") %>
    
            <!-- Content Wrapper -->
            <div class="flex-1 flex flex-col ml-0 lg:ml-[260px] h-screen overflow-hidden">
    
                <!-- Header -->
                <header
                    class="h-20 shrink-0 bg-surface-container-lowest border-b border-outline-variant flex items-center gap-4 px-6 z-20">
                    <button onclick="toggleSidebar()" class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg mr-2 flex items-center justify-center">
                        <span class="material-symbols-outlined text-[24px]">menu</span>
                    </button>
                    <a href="/admin/doctors" class="inline-flex items-center justify-center p-2 rounded-full hover:bg-slate-100 text-slate-600 transition-colors border border-slate-200">
                        <span class="material-symbols-outlined">arrow_back</span>
                    </a>
                    <div>
                        <h2 class="font-headline-lg text-headline-md font-bold text-primary">
                            Doctor Management
                        </h2>
                    </div>
                </header>
    
                <!-- Main Content -->
                <main class="flex-1 overflow-y-auto overflow-x-hidden p-4 lg:p-8">
    
                    <!-- Profile Hero Header -->
                    <section
                        class="bg-surface-container-lowest rounded-xl p-lg shadow-[0px_4px_12px_rgba(0,0,0,0.05)] mb-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
    
                        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-xl text-center sm:text-left">
                            <div class="relative">
                                <img alt="Dr. <%= doctor.firstName %> <%= doctor.lastName %>"
                                    class="w-32 h-32 rounded-xl object-cover shadow-sm"
                                    src="<%= doctor.profilePhoto || '/images/default-avatar.svg' %>"
                                    onerror="this.onerror=null; this.src='/images/default-avatar.svg';" />
                            </div>
    
                            <div>
                                <h2 class="text-4xl font-bold text-primary mb-1">
                                    Dr. <%= doctor.firstName %>
                                        <%= doctor.lastName %>
                                </h2>
    
                                <p class="text-on-surface-variant flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary">
                                        medical_services
                                    </span>
    
                                    <% if(doctor.speciality && doctor.speciality.length> 0) { %>
                                        <%= doctor.speciality[0].name %> Specialist
                                            <% } else { %>
                                                General Practitioner
                                                <% } %>
                                </p>
    
                                <div class="flex flex-wrap gap-2 mt-4">
                                    <span
                                        class="px-4 py-1 bg-secondary-container/30 text-secondary rounded-full border border-secondary/20">
                                        Verified Professional
                                    </span>
    
                                    <span class="px-4 py-1 bg-primary-fixed text-on-primary-fixed rounded-full">
                                        Medical ID: #<%= doctor.id %>
                                    </span>

                                    <% if (doctor.credential && doctor.credential.isActive) { %>
                                        <span class="px-4 py-1 bg-emerald-100 text-emerald-800 rounded-full border border-emerald-200 font-semibold text-[13px]">
                                            Active
                                        </span>
                                    <% } else { %>
                                        <span class="px-4 py-1 bg-rose-100 text-rose-800 rounded-full border border-rose-200 font-semibold text-[13px]">
                                            Deactivated
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
    
                        <div class="flex flex-col sm:flex-row gap-3">
                            <div class="relative inline-block text-left" id="doctorViewDropdown">
                                <button type="button" onclick="toggleDoctorViewMenu(event)"
                                    class="flex items-center gap-2 bg-[#002868] text-white px-6 py-3 rounded-lg hover:shadow-lg transition font-medium text-sm">
                                    <span class="material-symbols-outlined">visibility</span>
                                    View Doctor Portal
                                    <span class="material-symbols-outlined text-[18px]">keyboard_arrow_down</span>
                                </button>
                                <div id="doctorViewMenu" class="hidden absolute right-0 mt-2 w-56 rounded-xl bg-white border border-outline-variant shadow-2xl z-50 py-2">
                                    <a href="/doctor/dashboard?doctorId=<%= doctor.id %>"
                                        class="flex items-center gap-3 px-4 py-2.5 text-label-lg text-slate-700 hover:bg-[#002868]/5 hover:text-[#002868] transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">grid_view</span>
                                        Dashboard
                                    </a>
                                    <a href="/doctor/appointments?doctorId=<%= doctor.id %>"
                                        class="flex items-center gap-3 px-4 py-2.5 text-label-lg text-slate-700 hover:bg-[#002868]/5 hover:text-[#002868] transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">event</span>
                                        Upcoming Appointments
                                    </a>
                                    <a href="/doctor/all-appointments?doctorId=<%= doctor.id %>"
                                        class="flex items-center gap-3 px-4 py-2.5 text-label-lg text-slate-700 hover:bg-[#002868]/5 hover:text-[#002868] transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">calendar_month</span>
                                        All Appointments
                                    </a>
                                    <a href="/doctor/schedule?doctorId=<%= doctor.id %>"
                                        class="flex items-center gap-3 px-4 py-2.5 text-label-lg text-slate-700 hover:bg-[#002868]/5 hover:text-[#002868] transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">schedule</span>
                                        Schedule
                                    </a>
                                    <a href="/doctor/leaves?doctorId=<%= doctor.id %>"
                                        class="flex items-center gap-3 px-4 py-2.5 text-label-lg text-slate-700 hover:bg-[#002868]/5 hover:text-[#002868] transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">event_busy</span>
                                        Leaves
                                    </a>
                                    <a href="/doctor/earnings?doctorId=<%= doctor.id %>"
                                        class="flex items-center gap-3 px-4 py-2.5 text-label-lg text-slate-700 hover:bg-[#002868]/5 hover:text-[#002868] transition-colors">
                                        <span class="material-symbols-outlined text-[20px]">payments</span>
                                        Earnings & Invoices
                                    </a>
                                </div>
                            </div>

                            <a href= "/admin/doctorProfile/edit?doctorId=<%= doctor.id %>"
                                class="flex items-center gap-2 bg-primary text-on-primary px-6 py-3 rounded-lg hover:shadow-lg transition text-sm font-semibold">
                                <span class="material-symbols-outlined">edit</span>
                                Edit Profile
                            </a>

                            <% if (doctor.credential) { %>
                                <button onclick="toggleDoctorStatus('<%= doctor.credentialId %>', <%= doctor.credential.isActive %>)"
                                    class="flex items-center gap-2 px-6 py-3 rounded-lg font-semibold border transition text-sm <%= doctor.credential.isActive ? 'border-rose-200 text-rose-600 hover:bg-rose-50' : 'border-emerald-200 text-emerald-600 hover:bg-emerald-50' %>">
                                    <span class="material-symbols-outlined">
                                        <%= doctor.credential.isActive ? 'block' : 'check_circle' %>
                                    </span>
                                    <%= doctor.credential.isActive ? 'Deactivate' : 'Activate' %>
                                </button>
                            <% } %>
                        </div>
                    </section>
    
                    <!-- Stats Cards -->
                    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-6 mb-6">
    
                        <div class="bg-surface-container-lowest p-6 rounded-xl shadow border-l-4 border-primary">
                            <p class="text-sm text-on-surface-variant">
                                Professional Experience
                            </p>
    
                            <h3 class="text-4xl font-bold text-primary">
                                <%= doctor.expereince %>
                                    <span class="text-lg font-normal">Years</span>
                            </h3>
                        </div>
    
                        <div class="bg-surface-container-lowest p-6 rounded-xl shadow">
                            <p class="text-sm text-on-surface-variant">
                                Consultation Fee
                            </p>
    
                            <h3 class="text-4xl font-bold text-primary">
                                ₹<%= doctor.charges %>
                            </h3>
                        </div>
    
                        <div class="bg-surface-container-lowest p-6 rounded-xl shadow">
                            <p class="text-sm text-on-surface-variant">
                                Slot Duration
                            </p>
    
                            <h3 class="text-4xl font-bold text-primary">
                                <%= doctor.slotDuration || 15 %>
                                    <span class="text-lg font-normal">mins</span>
                            </h3>
                        </div>
    
                        <div class="bg-surface-container-lowest p-6 rounded-xl shadow">
                            <p class="text-sm text-on-surface-variant">
                                Languages
                            </p>
    
                            <p class="mt-2">
                                <%= Array.isArray(doctor.preferedLanguages) ? doctor.preferedLanguages.join(', ')
                            : doctor.preferedLanguages || ' Not specified' %>
                            </p>
                        </div>
    
                    </div>
    
                    <!-- Main Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
                        <!-- Left Side -->
                        <div class="space-y-6">
    
                            <!-- Specialties -->
                            <section class="bg-surface-container-lowest p-6 rounded-xl shadow">
    
                                <h4 class="font-semibold text-primary mb-4">
                                    Specialties
                                </h4>
    
                                <ul class="space-y-3">
                                    <% if(doctor.speciality && doctor.speciality.length> 0) { %>
                                        <% doctor.speciality.forEach(spec=> { %>
                                            <li>
                                                • <%= spec.name %>
                                            </li>
                                            <% }) %>
                                                <% } else { %>
                                                    <li>No specialties listed.</li>
                                                    <% } %>
                                </ul>
    
                            </section>
    
                            <!-- Personal Details -->
                            <section class="bg-surface-container-lowest p-6 rounded-xl shadow">
    
                                <h4 class="font-semibold text-primary mb-4">
                                    Personal Details
                                </h4>
    
                                <div class="space-y-4">
                                    <div>
                                        <p class="text-sm text-on-surface-variant">
                                            Date of Birth
                                        </p>
    
                                        <p>
                                            <%= doctor.dateOfBirth ? new Date(doctor.dateOfBirth).toLocaleDateString()
                                                : 'Not Provided' %>
                                        </p>
                                    </div>
    
                                    <div>
                                        <p class="text-sm text-on-surface-variant">
                                            Gender
                                        </p>
    
                                        <p>
                                            <%= doctor.gender %>
                                        </p>
                                    </div>
                                </div>
    
                            </section>
    
                        </div>
    
                        <!-- Right Side -->
                        <div class="lg:col-span-2">
    
                            <section class="bg-surface-container-lowest p-6 rounded-xl shadow h-full">
    
                                <h4 class="font-semibold text-primary mb-6">
                                    Education & Degrees
                                </h4>
    
                                <div class="space-y-6">
    
                                    <% if(doctor.degree && doctor.degree.length> 0) { %>
    
                                        <% doctor.degree.forEach((deg,index)=>{ %>
    
                                            <div class="flex gap-4">
    
                                                <div
                                                    class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center shrink-0">
                                                    <span class="material-symbols-outlined text-sm">
                                                        school
                                                    </span>
                                                </div>
    
                                                <div class="flex-1 bg-surface-container-low p-4 rounded-lg">
                                                    <h5 class="font-semibold">
                                                        <%= deg.courseName %>
                                                            (<%= deg.abbreviation %>)
                                                    </h5>
    
                                                    <p class="text-on-surface-variant">
                                                        <%= deg.institution %>
                                                    </p>
    
                                                    <p class="text-xs uppercase mt-1">
                                                        Class of <%= deg.passingYear %>
                                                    </p>
                                                </div>
    
                                            </div>
    
                                            <% }) %>
    
                                                <% } else { %>
    
                                                    <p>No degrees listed.</p>
    
                                                    <% } %>
    
                                </div>
    
                            </section>
    
                        </div>
    
                    </div>
    
                </main>
    
            </div>
    
        </div>

        <!-- Deactivate Doctor Modal -->
        <div id="deactivateDoctorModal" class="custom-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="deactivateDoctorModalTitle">
            <div class="custom-modal-card">
                <!-- Header accent -->
                <div class="custom-modal-header-accent"></div>

                <div class="custom-modal-body">
                    <div class="custom-modal-icon-wrapper">
                        <span class="material-symbols-outlined custom-modal-icon">person_off</span>
                    </div>
                    
                    <h3 id="deactivateDoctorModalTitle" class="custom-modal-title">
                        Deactivate Doctor Account
                    </h3>
                    
                    <p class="custom-modal-text">
                        Are you sure you want to deactivate
                        <span style="font-weight: 600; color: #0f172a;">Dr. <%= doctor.firstName %> <%= doctor.lastName %></span>?
                        They will no longer be able to sign in or manage their schedule.
                    </p>

                    <div class="custom-modal-warning-box">
                        <span class="material-symbols-outlined custom-modal-warning-icon">info</span>
                        <p class="custom-modal-warning-text">
                            This action disables login access and patient booking capabilities for this doctor. The record remains in the system for history.
                        </p>
                    </div>

                    <div class="custom-modal-actions">
                        <button type="button" id="cancelDeactivateDoctor" onclick="closeDeactivateDoctorModal()" class="custom-modal-btn custom-modal-btn-cancel">
                            Cancel
                        </button>
                        <button type="button" id="confirmDeactivateBtn" onclick="confirmDeactivateDoctor()" class="custom-modal-btn custom-modal-btn-confirm">
                            <span class="material-symbols-outlined" style="font-size: 18px;">block</span>
                            Deactivate Doctor
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </body>

    <script src="/js/doctor/profile.js"></script>
    <script src="/js/admin/doctorProfile.js"></script>
</body>

</html>