<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Invoice #<%= invoice.id %> | MedPortal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <style>
        @media print {
            body {
                background: white;
                color: black;
            }
            .no-print {
                display: none !important;
            }
            .print-border {
                border: 1px solid #e2e8f0 !important;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen py-8 px-4 flex flex-col items-center">
    <!-- Action Controls (Hidden on Print) -->
    <div class="w-full max-w-3xl mb-6 flex justify-between items-center no-print">
        <a href="javascript:window.close()" class="flex items-center gap-1.5 text-sm font-semibold text-slate-600 hover:text-slate-900 transition-colors">
            <span class="material-symbols-outlined text-base">arrow_back</span> Close Tab
        </a>
        
        <button onclick="window.print()" class="bg-[#002868] text-white px-5 py-2 rounded-lg font-semibold hover:bg-blue-900 active:scale-95 transition-all flex items-center gap-1.5 shadow-sm">
            <span class="material-symbols-outlined text-lg">print</span> Print / Save as PDF
        </button>
    </div>

    <!-- Formal Invoice Container -->
    <div class="w-full max-w-3xl bg-white border border-slate-200 rounded-xl shadow-md p-8 sm:p-12 print-border">
        <!-- Logo and Invoice Info Header -->
        <header class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6 border-b border-slate-100 pb-8 mb-8">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-[#002868] text-white rounded-xl flex items-center justify-center shadow-sm">
                    <span class="material-symbols-outlined text-2xl">medical_services</span>
                </div>
                <div>
                    <h1 class="font-bold text-xl text-[#002868] tracking-tight"><%= invoice.hospitalGroup %></h1>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider"><%= invoice.hospitalName %></p>
                </div>
            </div>
            
            <div class="text-left sm:text-right">
                <h2 class="font-bold text-2xl text-slate-800 uppercase tracking-wide mb-1">Invoice</h2>
                <p class="text-sm font-mono font-bold text-[#002868]">ID: #<%= invoice.id %></p>
                <p class="text-xs text-slate-400 font-medium mt-1">Date: <%= invoice.createdAt %></p>
            </div>
        </header>

        <!-- Doctor & Patient Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 mb-8 border-b border-slate-100 pb-8">
            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Billed By</p>
                <h3 class="font-bold text-slate-800 text-base"><%= invoice.doctorName %></h3>
                <p class="text-sm text-slate-500 mt-1"><%= invoice.hospitalName %></p>
                <% if (invoice.hospitalAddress) { %>
                    <p class="text-xs text-slate-400 mt-0.5">
                        <%= invoice.hospitalAddress.addressLine1 %> 
                        <%= invoice.hospitalAddress.addressLine2 ? ', ' + invoice.hospitalAddress.addressLine2 : '' %><br>
                        <%= invoice.hospitalAddress.city %>, <%= invoice.hospitalAddress.state %> - <%= invoice.hospitalAddress.pincode %><br>
                        <%= invoice.hospitalAddress.country %>
                    </p>
                <% } %>
            </div>

            <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Billed To</p>
                <h3 class="font-bold text-slate-800 text-base"><%= invoice.patientName %></h3>
                <p class="text-sm text-slate-500 mt-1">Hospital Patient Record</p>
                <p class="text-xs text-slate-400 mt-0.5">Payment Method: <span class="font-bold uppercase tracking-wider"><%= invoice.paidBy %></span></p>
            </div>
        </div>

        <!-- Invoice Table -->
        <div class="mb-8">
            <table class="w-full text-left">
                <thead>
                    <tr class="border-b border-slate-200 text-xs font-bold text-slate-400 uppercase tracking-wider">
                        <th class="pb-3">Description</th>
                        <th class="pb-3 text-right">Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    <tr>
                        <td class="py-4">
                            <h4 class="font-bold text-slate-800">Medical Consultation Session</h4>
                            <p class="text-xs text-slate-400 mt-0.5">Professional fee for diagnosis and prescription</p>
                        </td>
                        <td class="py-4 text-right font-semibold text-slate-800">₹<%= invoice.consultationFees %></td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Totals & Tax Calculation Breakdown -->
        <div class="flex flex-col items-end gap-3 border-t border-slate-200 pt-6">
            <div class="flex justify-between w-64 text-sm text-slate-500">
                <span>Subtotal (Net):</span>
                <span class="font-semibold text-slate-800">₹<%= invoice.consultationFees %></span>
            </div>
            
            <div class="flex justify-between w-64 text-sm text-slate-500">
                <span>GST / Tax Charges (<%= invoice.taxRate %>%):</span>
                <span class="font-semibold text-slate-800">₹<%= invoice.taxCharges %></span>
            </div>
            
            <div class="flex justify-between w-64 border-t border-slate-100 pt-3 text-base font-bold text-[#002868] mt-1">
                <span>Total Amount Due:</span>
                <span>₹<%= invoice.totalAmount %></span>
            </div>
        </div>

        <!-- Footer terms / Notes -->
        <footer class="mt-12 pt-8 border-t border-slate-100 text-center text-xs text-slate-400">
            <p class="font-medium">Thank you for visiting <%= invoice.hospitalGroup %>.</p>
            <p class="mt-1">For any queries regarding this billing statement, please contact our support desk.</p>
        </footer>
    </div>
</body>
</html>
