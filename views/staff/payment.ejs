<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <title>Payment & Confirmation | Care4U Staff</title>
    <%- include('partials/head') %>
        <link rel="stylesheet" href="/css/staff/payment.css">
</head>

<body class="bg-[#F4F5F7] text-on-surface flex h-screen overflow-hidden">

    <%- include('partials/sidebar') %>

        <div class="flex-1 flex flex-col h-screen overflow-hidden">
            <%- include('partials/topheader') %>

                <main class="flex-1 overflow-y-auto p-4 lg:p-8 max-w-full overflow-x-hidden ml-0 lg:ml-64">
                    <div class="max-w-6xl mx-auto space-y-6 pb-10">

                        <button onclick="history.back()"
                            class="inline-flex items-center gap-1 text-sm text-on-surface-variant hover:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                            Back to Slots
                        </button>

                        <div>
                            <h2 class="text-2xl font-bold text-on-surface">Confirm &amp; Pay</h2>
                            <p class="text-sm text-on-surface-variant mt-1">Review the appointment details and collect
                                payment from the patient.</p>
                        </div>

                        <div id="errorBanner"
                            class="hidden p-4 bg-red-50 border border-red-200 text-red-700 rounded-xl text-sm font-medium">
                        </div>

                        <div class="grid grid-cols-1 xl:grid-cols-5 gap-6">

                            <!-- LEFT: Payment Form -->
                            <div
                                class="xl:col-span-3 bg-white rounded-2xl shadow-sm border border-outline-variant/30 p-6 space-y-5">
                                <h3
                                    class="font-bold text-on-surface pb-3 border-b border-outline-variant/20 flex items-center gap-2">
                                    <span class="material-symbols-outlined text-primary text-[20px]">payments</span>
                                    Payment Details
                                </h3>

                                <div class="grid grid-cols-2 gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Consultation
                                            Fee (&#8377;)</label>
                                        <input readonly id="consultationFees" type="number" min="0" value="0"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Tax
                                            &amp; Charges (&#8377;)</label>
                                        <input readonly id="taxCharges" type="number" min="0" value="0"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label
                                        class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Total
                                        Amount (&#8377;)</label>
                                    <input id="totalAmount" type="number" readonly value="0"
                                        class="bg-emerald-50 border border-emerald-200 text-emerald-800 font-bold rounded-xl px-3 py-2.5 text-base cursor-default" />
                                </div>

                                <div class="grid grid-cols-2 gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Paid
                                            By</label>
                                        <select id="paidBy"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                                            <option value="PATIENT">Patient</option>
                                            <option value="INSURANCE">Insurance</option>
                                            <option value="OTHER">Other</option>
                                        </select>
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Payment
                                            Status</label>
                                        <select id="paymentStatus"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                                            <option value="SUCCESS">Success / Paid</option>
                                            <option value="PENDING">Pending</option>
                                            <option value="FAILED">Failed</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- Payment Method Tabs -->
                                <div>
                                    <p
                                        class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide mb-2">
                                        Payment Method</p>
                                    <div class="flex gap-2 flex-wrap">
                                        <button id="tabCash" onclick="switchTab('cash')"
                                            class="pay-tab active flex-1 min-w-[72px] py-2.5 rounded-xl text-sm font-semibold border border-[#002868]">Cash</button>
                                        <button id="tabCard" onclick="switchTab('card')"
                                            class="pay-tab flex-1 min-w-[72px] py-2.5 rounded-xl text-sm font-semibold border border-outline-variant bg-surface-container-lowest text-on-surface-variant">Card</button>
                                        <button id="tabUpi" onclick="switchTab('upi')"
                                            class="pay-tab flex-1 min-w-[72px] py-2.5 rounded-xl text-sm font-semibold border border-outline-variant bg-surface-container-lowest text-on-surface-variant">UPI</button>
                                        <button id="tabNetbank" onclick="switchTab('netbank')"
                                            class="pay-tab flex-1 min-w-[72px] py-2.5 rounded-xl text-sm font-semibold border border-outline-variant bg-surface-container-lowest text-on-surface-variant">Net
                                            Banking</button>
                                    </div>
                                </div>

                                <!-- Cash -->
                                <div id="fieldsCash" class="space-y-4">
                                    <div
                                        class="p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800 flex items-start gap-2">
                                        <span class="material-symbols-outlined text-[18px] mt-0.5 shrink-0">info</span>
                                        Patient is paying cash at reception. Confirm receipt before clicking Confirm.
                                    </div>
                                </div>

                                <!-- Card -->
                                <div id="fieldsCard" class="hidden space-y-4">
                                    <div class="flip-card w-full h-44 text-white select-none mx-auto max-w-[360px]">
                                        <div id="mockCardInner" class="flip-card-inner">
                                            <div
                                                class="flip-card-front bg-gradient-to-br from-[#0f172a] via-[#1e3a5f] to-[#002868] p-5 flex flex-col justify-between shadow-xl border border-slate-700/30">
                                                <div class="flex justify-between items-start">
                                                    <div>
                                                        <p
                                                            class="text-[9px] uppercase tracking-widest text-slate-400 font-semibold">
                                                            Care4U Staff</p>
                                                        <span class="font-bold text-sm tracking-wider text-white">Care4U
                                                            Pay</span>
                                                    </div>
                                                    <div class="flex items-center gap-1">
                                                        <div
                                                            class="w-8 h-5 bg-amber-400/90 rounded-md border border-amber-300 shadow-inner relative mr-1">
                                                            <div
                                                                class="absolute inset-0 grid grid-cols-3 grid-rows-3 gap-0.5 opacity-20">
                                                                <span
                                                                    class="border-r border-b border-black"></span><span
                                                                    class="border-r border-b border-black"></span><span
                                                                    class="border-b border-black"></span>
                                                                <span
                                                                    class="border-r border-b border-black"></span><span
                                                                    class="border-r border-b border-black"></span><span
                                                                    class="border-b border-black"></span>
                                                                <span class="border-r border-black"></span><span
                                                                    class="border-r border-black"></span><span></span>
                                                            </div>
                                                        </div>
                                                        <div class="relative w-8 h-6 flex">
                                                            <div
                                                                class="w-4 h-4 bg-red-500 rounded-full opacity-80 absolute left-0 top-1">
                                                            </div>
                                                            <div
                                                                class="w-4 h-4 bg-amber-500 rounded-full opacity-80 absolute right-0 top-1">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="text-base font-mono tracking-widest text-center py-1 text-white"
                                                    id="mockCardNumber">•••• •••• •••• ••••</div>
                                                <div class="flex justify-between items-end">
                                                    <div>
                                                        <p class="text-[8px] uppercase tracking-wider text-slate-400">
                                                            Card Holder</p>
                                                        <p class="text-[10px] font-semibold tracking-wide text-white uppercase"
                                                            id="mockCardHolder">PATIENT NAME</p>
                                                    </div>
                                                    <div>
                                                        <p class="text-[8px] uppercase tracking-wider text-slate-400">
                                                            Expires</p>
                                                        <p class="text-[10px] font-semibold font-mono text-white"
                                                            id="mockCardExpiry">MM/YY</p>
                                                    </div>
                                                </div>
                                            </div>
                                            <div
                                                class="flip-card-back bg-gradient-to-br from-[#0f172a] via-[#1e3a5f] to-[#002868] flex flex-col justify-between py-4 shadow-xl border border-slate-700/30">
                                                <div class="w-full h-8 bg-slate-950 mt-1"></div>
                                                <div class="px-5 space-y-1">
                                                    <p
                                                        class="text-[8px] uppercase tracking-widest text-slate-400 text-right">
                                                        CVV</p>
                                                    <div
                                                        class="w-full bg-white text-slate-800 font-mono py-1 px-3 text-right text-xs rounded font-bold italic tracking-widest shadow-inner relative flex items-center justify-end">
                                                        <span
                                                            class="absolute left-3 text-[8px] opacity-40 font-sans tracking-normal not-italic text-slate-600">Authorized
                                                            Signature</span>
                                                        <span id="mockCardCvv"
                                                            class="text-slate-900 font-bold">•••</span>
                                                    </div>
                                                </div>
                                                <div class="px-5 flex justify-between items-center">
                                                    <span
                                                        class="text-[8px] font-semibold tracking-wider text-slate-500">Care4U
                                                        Global Services</span>
                                                    <div class="relative w-6 h-4 flex opacity-40">
                                                        <div class="w-3 h-3 bg-red-500 rounded-full absolute left-0">
                                                        </div>
                                                        <div class="w-3 h-3 bg-amber-500 rounded-full absolute right-0">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Card
                                            Number</label>
                                        <input id="cardNumber" type="text" placeholder="1234 5678 9012 3456"
                                            maxlength="19"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                    <div class="grid grid-cols-2 gap-3">
                                        <div class="flex flex-col gap-1.5">
                                            <label
                                                class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Expiry</label>
                                            <input id="cardExpiry" type="text" placeholder="MM/YY" maxlength="5"
                                                class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                        </div>
                                        <div class="flex flex-col gap-1.5">
                                            <label
                                                class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">CVV</label>
                                            <input id="cardCvv" type="password" placeholder="•••" maxlength="4"
                                                class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Card
                                            Holder Name</label>
                                        <input id="cardHolderName" type="text" placeholder="Name on card" maxlength="50"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Transaction
                                            / Reference ID</label>
                                        <input id="cardTransactionId" type="text" placeholder="Bank reference number"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                </div>

                                <!-- UPI -->
                                <div id="fieldsUpi" class="hidden space-y-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">UPI
                                            ID</label>
                                        <input id="upiId" type="text" placeholder="e.g. patient@upi"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">UPI
                                            Transaction ID</label>
                                        <input id="upiTransactionId" type="text"
                                            placeholder="12-digit UPI transaction ID"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                </div>

                                <!-- Net Banking -->
                                <div id="fieldsNetbank" class="hidden space-y-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Bank
                                            Name</label>
                                        <input id="bankName" type="text" placeholder="e.g. HDFC Bank"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label
                                            class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Transaction
                                            Reference ID</label>
                                        <input id="netbankTransactionId" type="text"
                                            placeholder="Net banking reference number"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                </div>

                                <button id="confirmBtn" onclick="confirmBooking()"
                                    class="w-full bg-primary text-white py-3.5 rounded-xl text-sm font-semibold hover:bg-primary/90 transition-all shadow-sm flex items-center justify-center gap-2 mt-2">
                                    <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                    <span id="confirmBtnLabel">Confirm &amp; Book Appointment</span>
                                </button>
                                <p class="text-xs text-on-surface-variant text-center">Appointment is confirmed only
                                    after you click Confirm.</p>
                            </div>

                            <!-- RIGHT: Summary -->
                            <div class="xl:col-span-2 space-y-4">
                                <div
                                    class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 p-6 space-y-4">
                                    <h3
                                        class="font-bold text-on-surface pb-3 border-b border-outline-variant/20 flex items-center gap-2">
                                        <span
                                            class="material-symbols-outlined text-primary text-[20px]">receipt_long</span>
                                        Booking Summary
                                    </h3>
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-9 h-9 rounded-xl bg-blue-50 text-primary flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[18px]">person</span>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-outline font-semibold uppercase">Patient</p>
                                            <p id="summaryPatient" class="font-semibold text-on-surface text-sm">—</p>
                                            <p id="summaryPatientContact" class="text-xs text-on-surface-variant">—</p>
                                        </div>
                                    </div>
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-9 h-9 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[18px]">stethoscope</span>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-outline font-semibold uppercase">Doctor</p>
                                            <p id="summaryDoctor" class="font-semibold text-on-surface text-sm">—</p>
                                        </div>
                                    </div>
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                                            <span class="material-symbols-outlined text-[18px]">calendar_month</span>
                                        </div>
                                        <div>
                                            <p class="text-[10px] text-outline font-semibold uppercase">Date &amp; Time
                                            </p>
                                            <p id="summarySlot"
                                                class="font-bold text-primary text-sm bg-primary/10 px-2 py-0.5 rounded-md inline-block mt-0.5">
                                                —</p>
                                        </div>
                                    </div>
                                </div>

                                <div
                                    class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 p-6 space-y-3">
                                    <h3
                                        class="font-bold text-on-surface pb-3 border-b border-outline-variant/20 flex items-center gap-2">
                                        <span
                                            class="material-symbols-outlined text-emerald-600 text-[20px]">price_check</span>
                                        Fee Breakdown
                                    </h3>
                                    <div class="flex justify-between text-sm">
                                        <span class="text-on-surface-variant">Consultation Fee</span>
                                        <span id="summFee" class="font-semibold text-on-surface">&#8377;0</span>
                                    </div>
                                    <div class="flex justify-between text-sm">
                                        <span class="text-on-surface-variant">Tax &amp; Charges</span>
                                        <span id="summTax" class="font-semibold text-on-surface">&#8377;0</span>
                                    </div>
                                    <div
                                        class="flex justify-between text-sm font-bold pt-2 border-t border-outline-variant/30">
                                        <span class="text-on-surface">Total</span>
                                        <span id="summTotal" class="text-primary text-base">&#8377;0</span>
                                    </div>
                                </div>

                                <div
                                    class="bg-white rounded-2xl shadow-sm border border-outline-variant/30 p-4 flex items-center gap-3">
                                    <div id="payMethodIcon"
                                        class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
                                        <span class="material-symbols-outlined text-[18px]">payments</span>
                                    </div>
                                    <div>
                                        <p class="text-[10px] text-outline font-semibold uppercase">Collecting Via</p>
                                        <p id="payMethodLabel" class="font-semibold text-on-surface text-sm">Cash</p>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </main>
        </div>

        <!-- Success Overlay -->
        <div id="successOverlay">
            <div class="success-card">
                <div class="checkmark-circle">
                    <span class="material-symbols-outlined text-white text-3xl">check</span>
                </div>
                <h2 class="text-xl font-bold text-on-surface mb-2">Booking Confirmed!</h2>
                <p class="text-sm text-on-surface-variant mb-1">Appointment has been booked successfully.</p>
                <p id="successRef" class="text-xs text-primary font-semibold mb-6"></p>
                <a href="/staff/appointments"
                    class="inline-block bg-primary text-white px-6 py-2.5 rounded-xl text-sm font-semibold hover:bg-primary/90 transition-colors">
                    View Appointments
                </a>
            </div>
        </div>

        <div id="toast"
            class="fixed bottom-4 right-4 bg-gray-800 text-white px-4 py-2.5 rounded-xl shadow-xl transform transition-all duration-300 translate-y-20 opacity-0 z-50 text-sm font-medium flex items-center gap-2">
        </div>

        <script src="/js/staff/payment.js"></script>
</body>

</html>