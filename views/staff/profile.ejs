<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <title>My Profile | Care4U Staff</title>
    <%- include('partials/head') %>
    <meta name="description" content="Manage and update your staff profile information on Care4U." />
</head>
<body class="bg-[#F4F5F7] text-on-surface flex h-screen overflow-hidden">

    <%- include('partials/sidebar') %>

    <div class="flex-1 flex flex-col h-screen overflow-hidden">
        <%- include('partials/topheader') %>

        <main class="flex-1 overflow-y-auto p-md ml-0 lg:ml-64">
            <div class="max-w-4xl mx-auto space-y-6 pb-lg">

                <!-- Page Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <h2 class="text-2xl font-bold text-on-surface">My Profile</h2>
                        <p class="text-sm text-on-surface-variant mt-0.5">View and update your personal information</p>
                    </div>
                    <span class="inline-flex items-center gap-1.5 text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-3 py-1.5 rounded-full">
                        <span class="material-symbols-outlined text-[14px]">local_hospital</span>
                        <%= profileData.hospitalName || 'Hospital' %>
                    </span>
                </div>

                <!-- Success / Error Toast -->
                <div id="toast" class="hidden fixed bottom-5 right-5 z-50 flex items-center gap-3 px-5 py-3 rounded-xl shadow-xl text-white text-sm font-semibold transition-all duration-300">
                    <span class="material-symbols-outlined text-[20px]" id="toastIcon">check_circle</span>
                    <span id="toastMsg"></span>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                    <!-- ── Left: Profile card ── -->
                    <div class="lg:col-span-1">
                        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-6 flex flex-col items-center text-center gap-4">
                            <!-- Avatar -->
                            <div class="relative">
                                <div id="avatarRing" class="w-24 h-24 rounded-full bg-primary/10 border-4 border-primary/20 flex items-center justify-center overflow-hidden">
                                    <% if (profileData.profilePhoto) { %>
                                        <img id="avatarImg" src="<%= profileData.profilePhoto %>" alt="Profile" class="w-full h-full object-cover" onerror="this.style.display='none'; document.getElementById('avatarInitials').style.display='flex';" />
                                        <div id="avatarInitials" class="hidden w-full h-full items-center justify-center">
                                            <span class="text-3xl font-bold text-primary"><%= profileData.firstName ? profileData.firstName.charAt(0).toUpperCase() : 'S' %></span>
                                        </div>
                                    <% } else { %>
                                        <span class="text-3xl font-bold text-primary"><%= profileData.firstName ? profileData.firstName.charAt(0).toUpperCase() : 'S' %></span>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Name & Role -->
                            <div>
                                <h3 class="text-lg font-bold text-on-surface" id="displayName">
                                    <%= profileData.firstName %> <%= profileData.lastName %>
                                </h3>
                                <p class="text-sm text-on-surface-variant">Front Desk Staff</p>
                                <p class="text-xs text-outline mt-0.5"><%= profileData.email %></p>
                            </div>

                            <!-- Info pills -->
                            <div class="w-full space-y-2 text-left">
                                <div class="flex items-center gap-2 bg-surface-container-low rounded-lg px-3 py-2">
                                    <span class="material-symbols-outlined text-outline text-[16px]">phone</span>
                                    <span class="text-sm text-on-surface-variant" id="displayMobile"><%= profileData.mobile || 'Not set' %></span>
                                </div>
                                <div class="flex items-center gap-2 bg-surface-container-low rounded-lg px-3 py-2">
                                    <span class="material-symbols-outlined text-outline text-[16px]">wc</span>
                                    <span class="text-sm text-on-surface-variant"><%= profileData.gender || 'Not set' %></span>
                                </div>
                                <div class="flex items-center gap-2 bg-surface-container-low rounded-lg px-3 py-2">
                                    <span class="material-symbols-outlined text-outline text-[16px]">cake</span>
                                    <span class="text-sm text-on-surface-variant">
                                        <% if (profileData.dateOfBirth) { %>
                                            <%= new Date(profileData.dateOfBirth).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                        <% } else { %>
                                            Not set
                                        <% } %>
                                    </span>
                                </div>
                                <div class="flex items-center gap-2 bg-surface-container-low rounded-lg px-3 py-2">
                                    <span class="material-symbols-outlined text-outline text-[16px]">business</span>
                                    <span class="text-sm text-on-surface-variant"><%= profileData.hospitalGroupName || 'N/A' %></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Right: Edit form ── -->
                    <div class="lg:col-span-2 space-y-5">

                        <!-- Personal Information -->
                        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
                            <div class="px-6 py-4 border-b border-outline-variant/20 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">person</span>
                                <h4 class="font-bold text-on-surface">Personal Information</h4>
                            </div>
                            <form id="profileForm" class="p-6 space-y-4">
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label for="firstName" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">First Name <span class="text-red-500">*</span></label>
                                        <input id="firstName" name="firstName" type="text" required value="<%= profileData.firstName || '' %>"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="middleName" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Middle Name</label>
                                        <input id="middleName" name="middleName" type="text" value="<%= profileData.middleName || '' %>"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="lastName" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Last Name <span class="text-red-500">*</span></label>
                                        <input id="lastName" name="lastName" type="text" required value="<%= profileData.lastName || '' %>"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                </div>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label for="gender" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Gender</label>
                                        <select id="gender" name="gender"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all">
                                            <option value="">Select gender</option>
                                            <option value="MALE" <%= profileData.gender === 'MALE' ? 'selected' : '' %>>Male</option>
                                            <option value="FEMALE" <%= profileData.gender === 'FEMALE' ? 'selected' : '' %>>Female</option>
                                        </select>
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="dateOfBirth" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Date of Birth</label>
                                        <input id="dateOfBirth" name="dateOfBirth" type="date"
                                            value="<%= profileData.dateOfBirth ? new Date(profileData.dateOfBirth).toISOString().split('T')[0] : '' %>"
                                            max="<%= new Date().toISOString().split('T')[0] %>"
                                            class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                    </div>
                                </div>

                                <div class="flex flex-col gap-1.5">
                                    <label for="profilePhoto" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Profile Photo URL</label>
                                    <div class="flex gap-2">
                                        <input id="profilePhoto" name="profilePhoto" type="url" value="<%= profileData.profilePhoto || '' %>"
                                            placeholder="https://example.com/photo.jpg"
                                            class="flex-1 bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                        <button type="button" onclick="previewPhoto()"
                                            class="px-3 py-2 bg-surface-container border border-outline-variant rounded-lg text-sm font-medium hover:bg-outline-variant/30 transition-all whitespace-nowrap">
                                            Preview
                                        </button>
                                    </div>
                                    <p class="text-[11px] text-on-surface-variant">Enter a publicly accessible image URL for your profile photo.</p>
                                </div>

                                <div class="pt-2 flex justify-end">
                                    <button id="savePersonalBtn" type="submit"
                                        class="flex items-center gap-2 bg-primary text-white px-6 py-2.5 rounded-lg text-sm font-semibold hover:bg-primary/90 transition-all active:scale-95 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                                        <span class="material-symbols-outlined text-[18px]">save</span>
                                        Save Changes
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Contact Information -->
                        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
                            <div class="px-6 py-4 border-b border-outline-variant/20 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">contact_page</span>
                                <h4 class="font-bold text-on-surface">Contact Information</h4>
                            </div>
                            <form id="contactForm" class="p-6 space-y-4">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                    <div class="flex flex-col gap-1.5">
                                        <label for="email" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Email Address</label>
                                        <div class="relative">
                                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[16px]">mail</span>
                                            <input id="email" name="email" type="email" value="<%= profileData.email || '' %>"
                                                class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-9 pr-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                        </div>
                                    </div>
                                    <div class="flex flex-col gap-1.5">
                                        <label for="mobile" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Mobile Number</label>
                                        <div class="relative">
                                            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[16px]">phone</span>
                                            <input id="mobile" name="mobile" type="tel" value="<%= profileData.mobile || '' %>"
                                                class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-9 pr-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                                        </div>
                                    </div>
                                </div>

                                <div class="p-3 bg-amber-50 border border-amber-200 rounded-lg flex items-start gap-2">
                                    <span class="material-symbols-outlined text-amber-600 text-[18px] shrink-0 mt-0.5">warning</span>
                                    <p class="text-xs text-amber-800">Changing your email or mobile number will update your login credentials. Make sure to remember the new values.</p>
                                </div>

                                <div class="pt-2 flex justify-end">
                                    <button id="saveContactBtn" type="submit"
                                        class="flex items-center gap-2 bg-primary text-white px-6 py-2.5 rounded-lg text-sm font-semibold hover:bg-primary/90 transition-all active:scale-95 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed">
                                        <span class="material-symbols-outlined text-[18px]">save</span>
                                        Update Contact
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Account Info (read-only) -->
                        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden">
                            <div class="px-6 py-4 border-b border-outline-variant/20 flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary text-[20px]">badge</span>
                                <h4 class="font-bold text-on-surface">Account Information</h4>
                            </div>
                            <div class="p-6 grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div class="bg-surface-container-low rounded-lg p-4">
                                    <p class="text-[10px] text-outline font-semibold uppercase tracking-wide mb-1">Staff ID</p>
                                    <p class="text-sm font-mono font-bold text-on-surface">#<%= profileData.id ? String(profileData.id).slice(-10) : 'N/A' %></p>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-4">
                                    <p class="text-[10px] text-outline font-semibold uppercase tracking-wide mb-1">Hospital Branch</p>
                                    <p class="text-sm font-semibold text-on-surface"><%= profileData.hospitalName || 'N/A' %></p>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-4">
                                    <p class="text-[10px] text-outline font-semibold uppercase tracking-wide mb-1">Hospital Group</p>
                                    <p class="text-sm font-semibold text-on-surface"><%= profileData.hospitalGroupName || 'N/A' %></p>
                                </div>
                                <div class="bg-surface-container-low rounded-lg p-4">
                                    <p class="text-[10px] text-outline font-semibold uppercase tracking-wide mb-1">Role</p>
                                    <p class="text-sm font-semibold text-on-surface flex items-center gap-1">
                                        <span class="material-symbols-outlined text-emerald-600 text-[16px]">verified</span>
                                        Front Desk Staff
                                    </p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/staff/profile.js"></script>
</body>
</html>
