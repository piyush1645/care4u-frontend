<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Reset Password - MedCentral Clinician Portal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config" src="/js/auth/tailwind-config.js"></script>
    <link rel="stylesheet" href="/css/auth/resetPassword.css">
</head>
<body class="min-h-screen flex items-center justify-center p-margin-mobile md:p-0">
    <div class="fixed inset-0 z-[-1] overflow-hidden opacity-40">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary/5 blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-secondary/5 blur-[120px]"></div>
    </div>
    
    <main class="w-full max-w-[440px] animate-in fade-in slide-in-from-bottom-4 duration-700">
        <div class="flex flex-col items-center mb-xl">
            <div class="w-16 h-16 bg-primary-container rounded-xl flex items-center justify-center mb-md shadow-sm">
                <span class="material-symbols-outlined text-[40px] text-on-primary-container">lock_reset</span>
            </div>
            <h1 class="font-headline-md text-headline-md text-primary tracking-tight">MedCentral</h1>
            <p class="font-label-sm text-label-sm text-outline uppercase tracking-widest">Clinical Portal</p>
        </div>

        <div class="tonal-layer-1 rounded-xl p-xl border border-surface-variant/50">
            <div class="text-center mb-lg">
                <h2 class="font-headline-sm text-headline-sm text-on-surface mb-xs">Reset Your Password</h2>
                <p class="font-body-md text-body-md text-on-surface-variant px-sm">
                    Enter your new secure password to access your clinical dashboard.
                </p>
            </div>
            
            <form id="reset-form" class="space-y-lg">
                <!-- New Password Field -->
                <div class="space-y-xs">
                    <label class="font-label-lg text-label-lg text-on-surface-variant ml-1" for="password">New Password</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-md flex items-center pointer-events-none text-outline group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">lock</span>
                        </div>
                        <input
                            class="block w-full pl-11 pr-12 py-3 bg-surface-container-low border-0 focus:ring-2 focus:ring-primary rounded-lg font-body-md text-on-surface transition-all placeholder:text-outline/60"
                            id="password" name="password" type="password" required placeholder="••••••••" />
                        <button type="button" class="absolute inset-y-0 right-0 pr-md flex items-center text-outline hover:text-primary" onclick="togglePasswordVisibility('password', this)">
                            <span class="material-symbols-outlined text-[20px]">visibility</span>
                        </button>
                    </div>
                </div>

                <!-- Confirm Password Field -->
                <div class="space-y-xs">
                    <label class="font-label-lg text-label-lg text-on-surface-variant ml-1" for="confirm-password">Confirm Password</label>
                    <div class="relative group">
                        <div class="absolute inset-y-0 left-0 pl-md flex items-center pointer-events-none text-outline group-focus-within:text-primary transition-colors">
                            <span class="material-symbols-outlined text-[20px]">lock</span>
                        </div>
                        <input
                            class="block w-full pl-11 pr-12 py-3 bg-surface-container-low border-0 focus:ring-2 focus:ring-primary rounded-lg font-body-md text-on-surface transition-all placeholder:text-outline/60"
                            id="confirm-password" name="confirm-password" type="password" required placeholder="••••••••" />
                        <button type="button" class="absolute inset-y-0 right-0 pr-md flex items-center text-outline hover:text-primary" onclick="togglePasswordVisibility('confirm-password', this)">
                            <span class="material-symbols-outlined text-[20px]">visibility</span>
                        </button>
                    </div>
                </div>

                <button
                    class="w-full bg-primary hover:bg-primary/90 text-on-primary font-label-lg text-label-lg py-3.5 px-xl rounded-lg shadow-sm active:scale-[0.98] transition-all flex items-center justify-center gap-sm group"
                    type="submit">
                    Reset Password
                    <span class="material-symbols-outlined text-[18px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
                </button>
            </form>
        </div>

        <footer class="mt-xl text-center space-y-md">
            <div class="flex items-center justify-center gap-md">
                <div class="flex items-center gap-xs text-secondary font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[16px]">enhanced_encryption</span>
                    HIPAA Compliant
                </div>
                <div class="w-1 h-1 bg-outline-variant rounded-full"></div>
                <div class="flex items-center gap-xs text-outline font-label-sm text-label-sm">
                    <span class="material-symbols-outlined text-[16px]">verified_user</span>
                    Secure Session
                </div>
            </div>
            <p class="font-label-sm text-label-sm text-outline-variant max-w-[300px] mx-auto">
                © 2024 MedCentral Healthcare Systems. Confidential Clinician Portal.
            </p>
        </footer>
    </main>

    <script src="/js/auth/resetPassword.js"></script>
</body>
</html>
