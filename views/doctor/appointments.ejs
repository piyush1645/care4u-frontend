<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MedCentral | Appointments Management</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="/js/doctor/tailwind-config.js"></script>
    <link rel="stylesheet" href="/css/doctor/common.css">
</head>

<body class="bg-background text-on-background flex h-screen overflow-hidden">
    <!-- SideNavBar Anchor -->
    <%- include("partials/leftNavBar.ejs") %>

        <!-- Main Wrapper -->
        <div class="flex-1 flex flex-col h-screen overflow-hidden w-full">
            <!-- TopNavBar Anchor -->
            <%- include("partials/topHeader.ejs") %>
                <!-- Main Content Area -->
                <main class="p-4 lg:p-8 flex flex-col lg:flex-row gap-8 flex-1 overflow-y-auto">
                    <!-- Left Filter Panel (Internal to Content) -->
                    <aside class="w-full lg:w-72 shrink-0 space-y-8">
                        <div>
                            <h2 class="font-headline-sm text-headline-sm text-on-background mb-4">Filters</h2>
                            <!-- Date Range Filter -->
                            <div class="bg-surface-container-lowest p-6 rounded-xl card-shadow mb-4">
                                <p
                                    class="font-label-lg text-label-lg text-on-surface-variant mb-3 uppercase tracking-wider">
                                    Date Range</p>
                                <div class="space-y-2">
                                    <button data-range="today"
                                        class="w-full text-left px-3 py-2 rounded-lg bg-primary-fixed text-primary font-body-md flex justify-between items-center filter-range-btn">
                                        Today
                                        <span class="material-symbols-outlined text-sm">calendar_month</span>
                                    </button>
                                    <button data-range="tomorrow"
                                        class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors font-body-md text-on-surface filter-range-btn">Tomorrow</button>
                                    <button data-range="this-week"
                                        class="w-full text-left px-3 py-2 rounded-lg hover:bg-surface-container-high transition-colors font-body-md text-on-surface filter-range-btn">This Week</button>
                                </div>
                            </div>
                            <!-- Status Filter -->
                            <div class="bg-surface-container-lowest p-6 rounded-xl card-shadow mb-4">
                                <p
                                    class="font-label-lg text-label-lg text-on-surface-variant mb-3 uppercase tracking-wider">
                                    Status</p>
                                <div class="space-y-3">
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input checked data-status-filter="Confirmed"
                                            class="rounded border-outline-variant text-primary focus:ring-primary h-5 w-5 filter-status-cb"
                                            type="checkbox" />
                                        <span
                                            class="font-body-md text-on-surface group-hover:text-primary transition-colors">Confirmed</span>
                                    </label>
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input checked data-status-filter="ON_GOING"
                                            class="rounded border-outline-variant text-primary focus:ring-primary h-5 w-5 filter-status-cb"
                                            type="checkbox" />
                                        <span
                                            class="font-body-md text-on-surface group-hover:text-primary transition-colors">In Consultation</span>
                                    </label>
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input checked data-status-filter="COMPLETED"
                                            class="rounded border-outline-variant text-primary focus:ring-primary h-5 w-5 filter-status-cb"
                                            type="checkbox" />
                                        <span
                                            class="font-body-md text-on-surface group-hover:text-primary transition-colors">Completed</span>
                                    </label>
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input checked data-status-filter="CANCELLED"
                                            class="rounded border-outline-variant text-primary focus:ring-primary h-5 w-5 filter-status-cb"
                                            type="checkbox" />
                                        <span
                                            class="font-body-md text-on-surface group-hover:text-primary transition-colors">Cancelled</span>
                                    </label>
                                    <label class="flex items-center gap-3 cursor-pointer group">
                                        <input checked data-status-filter="NO_SHOW"
                                            class="rounded border-outline-variant text-primary focus:ring-primary h-5 w-5 filter-status-cb"
                                            type="checkbox" />
                                        <span
                                            class="font-body-md text-on-surface group-hover:text-primary transition-colors">No Show</span>
                                    </label>
                                </div>
                            </div>
                            
                        </div>
                        <!-- Small Promotion/Alert Card -->
                        <div class="bg-primary p-6 rounded-xl text-on-primary relative overflow-hidden">
                            <div class="relative z-10">
                                <h3 class="font-headline-sm text-headline-sm mb-2">Telehealth Update</h3>
                                <p class="font-body-md opacity-90 mb-4">You have 3 remote sessions scheduled for
                                    tomorrow
                                    morning.</p>
                                <button
                                    class="bg-white text-primary px-4 py-2 rounded-lg font-label-lg transition-transform active:scale-95">Review
                                    Prep</button>
                            </div>
                            <div class="absolute -right-4 -bottom-4 opacity-10">
                                <span class="material-symbols-outlined !text-8xl">video_call</span>
                            </div>
                        </div>
                    </aside>
                    <!-- Appointments List Section -->
                    <section class="flex-1">
                        <div class="flex justify-between items-end mb-6">
                            <div>
                                <h2 class="font-display-lg text-display-lg text-primary"><%= todayFormatted %></h2>
                                <p id="appointments-count-display" class="font-body-lg text-on-surface-variant">Showing <%= totalAppointments %> appointments for your
                                    schedule.</p>
                            </div>
                            
                        </div>
                        <!-- Appointment Cards Grid -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 2xl:grid-cols-3 gap-6">
                            <% upcomingAppointments.forEach((app) => { %>
                            <!-- Appointment Card -->
                            <div class="appointment-card bg-surface-container-lowest p-6 rounded-xl card-shadow border border-transparent hover:border-primary/20 transition-all group"
                                 data-status="<%= app.status %>"
                                 data-time-ms="<%= app.startTimeMs %>"
                                 data-end-time-ms="<%= app.endTimeMs %>">
                                <div class="flex justify-between items-start mb-4">
                                    <div class="flex items-center gap-4">
                                        <img alt="Patient Photo" class="w-12 h-12 rounded-full object-cover"
                                            src="<%= app.patientPhoto || '/images/default-avatar.svg' %>"
                                            onerror="this.onerror=null; this.src='/images/default-avatar.svg';" />
                                        <div>
                                            <h4
                                                class="font-headline-sm text-headline-sm text-on-background group-hover:text-primary transition-colors">
                                                <a href="/doctor/patients/<%= app.patientId %>" class="hover:underline"><%= app.patientName %></a></h4>
                                            <p class="font-label-sm text-label-sm text-on-surface-variant">ID: #MC-<%= app.patientId %>
                                            </p>
                                        </div>
                                    </div>
                                    <span
                                        class="px-3 py-1 rounded-full font-label-sm text-label-sm
                                        <% if(app.status === 'Confirmed' || app.status === 'RESCHEDULED'){ %>
                                            bg-blue-100 text-blue-800 border border-blue-200
                                        <% } else if(app.status === 'ON_GOING') { %>
                                            bg-amber-100 text-amber-800 border border-amber-200
                                        <% } else if(app.status === 'COMPLETED') { %>
                                            bg-emerald-100 text-emerald-800 border border-emerald-200
                                        <% } else if(app.status === 'CANCELLED') { %>
                                            bg-red-100 text-red-800 border border-red-200
                                        <% } else if(app.status === 'NO_SHOW') { %>
                                            bg-slate-100 text-slate-800 border border-slate-200
                                        <% } else { %>
                                            bg-tertiary-fixed text-on-tertiary-fixed-variant
                                        <% } %>">
                                        <%= app.status === 'ON_GOING' ? 'In Consultation' : (app.status === 'NO_SHOW' ? 'No Show' : app.status) %>
                                    </span>
                                </div>
                                <div class="space-y-3 pt-4 border-t border-outline-variant/30">
                                    <div class="flex items-center gap-3 text-on-surface-variant">
                                        <span class="material-symbols-outlined text-primary">schedule</span>
                                        <span class="font-body-md"><%= app.time %></span>
                                    </div>
                                    <div class="flex items-center gap-3 text-on-surface-variant">
                                        <span class="material-symbols-outlined text-primary">medical_services</span>
                                        <span class="font-body-md"><%= app.reason %></span>
                                    </div>
                                    <div class="flex items-center gap-3">
                                        <span class="material-symbols-outlined <%= app.type === 'ONLINE' ? 'text-blue-600' : 'text-slate-500' %>">
                                            <%= app.type === 'ONLINE' ? 'video_call' : 'home' %>
                                        </span>
                                        <span class="font-body-md font-semibold <%= app.type === 'ONLINE' ? 'text-blue-600' : 'text-slate-600' %>">
                                            <%= app.type === 'ONLINE' ? 'Online Video Session' : 'In-Person Consultation' %>
                                        </span>
                                    </div>
                                </div>
                                
                                <% if (app.type === 'ONLINE') { %>
                                    <div class="mt-4 p-3 rounded-lg bg-surface-container border border-outline-variant/30">
                                        <div class="flex items-center justify-between mb-2">
                                            <span class="text-label-sm font-bold text-primary flex items-center gap-1">
                                                <span class="material-symbols-outlined text-[16px]">videocam</span>
                                                Telehealth Call
                                            </span>
                                            <% if (app.meeting && app.meeting.status === 'IN_PROGRESS') { %>
                                                <span class="flex items-center gap-1 text-emerald-600 text-label-xs font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-100">
                                                    <span class="relative flex h-1.5 w-1.5">
                                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                                        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"></span>
                                                    </span>
                                                    LIVE
                                                </span>
                                            <% } else if (app.meeting && app.meeting.status === 'COMPLETED') { %>
                                                <span class="text-on-surface-variant/60 text-label-xs font-semibold bg-slate-50 px-2 py-0.5 rounded border border-slate-100 flex items-center gap-0.5">
                                                    <span class="material-symbols-outlined text-[12px] text-slate-400">check_circle</span>
                                                    Ended
                                                </span>
                                            <% } else { %>
                                                <span class="text-on-surface-variant/80 text-label-xs font-medium bg-slate-50 px-2 py-0.5 rounded border border-slate-100">Scheduled</span>
                                            <% } %>
                                        </div>
                                        
                                        <% if (locals.user && locals.user.role === 'DOCTOR') { %>
                                            <div class="flex gap-2">
                                                <% 
                                                const isTimeForDoctor = !app.startTimeMs || (new Date().getTime() >= app.startTimeMs);
                                                %>
                                                <% if (!isTimeForDoctor) { %>
                                                    <button disabled class="flex-1 py-1.5 bg-slate-100 text-slate-400 rounded-lg text-label-sm flex items-center justify-center gap-1 cursor-not-allowed border border-slate-200">
                                                        <span class="material-symbols-outlined text-[16px]">schedule</span>
                                                        Available at <%= new Date(app.startTimeMs).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                                                    </button>
                                                <% } else { %>
                                                    <% if (!app.meeting || app.meeting.status === 'UPCOMING') { %>
                                                        <button onclick="startZoomCall(this, '<%= app.id %>')" class="flex-1 py-1.5 bg-primary text-on-primary rounded-lg text-label-sm hover:opacity-90 transition-all flex items-center justify-center gap-1 font-semibold shadow-sm">
                                                            <span class="material-symbols-outlined text-[16px]">video_call</span>
                                                            Start Zoom Call
                                                        </button>
                                                    <% } else if (app.meeting.status === 'IN_PROGRESS') { %>
                                                        <a href="<%= app.meeting.startUrl %>" target="_blank" class="flex-1 py-1.5 bg-emerald-600 text-white rounded-lg text-label-sm hover:bg-emerald-700 transition-all flex items-center justify-center gap-1 text-center font-semibold shadow-sm">
                                                            <span class="material-symbols-outlined text-[16px]">play_arrow</span>
                                                            Join Call
                                                        </a>
                                                        <button onclick="endZoomCall(this, '<%= app.id %>')" class="px-3 py-1.5 bg-error text-on-error rounded-lg text-label-sm hover:bg-red-700 transition-all flex items-center justify-center gap-1 font-semibold shadow-sm">
                                                            <span class="material-symbols-outlined text-[16px]">call_end</span>
                                                            Cut
                                                        </button>
                                                    <% } else if (app.meeting.status === 'COMPLETED') { %>
                                                        <button disabled class="flex-1 py-1.5 bg-slate-100 text-slate-400 rounded-lg text-label-sm flex items-center justify-center gap-1 cursor-not-allowed border border-slate-200">
                                                            <span class="material-symbols-outlined text-[16px]">check</span>
                                                            Completed
                                                        </button>
                                                    <% } %>
                                                <% } %>
                                            </div>
                                        <% } else { %>
                                            <p class="text-[11px] text-on-surface-variant italic">Only the consulting doctor can start or manage this call.</p>
                                        <% } %>
                                    </div>
                                <% } %>
                                <div class="mt-6 flex gap-2 items-center relative">
                                    <a href="/doctor/patients/<%= app.patientId %>"
                                        class="flex-1 py-2 border border-outline-variant rounded-lg font-label-lg text-on-surface hover:bg-surface-container transition-colors text-center block">Details</a>
                                    
                                    <% if (app.status === 'Confirmed' || app.status === 'RESCHEDULED') { %>
                                        <!-- Primary Action: Check-in -->
                                        <% 
                                        const canCheckIn = !app.startTimeMs || (new Date().getTime() >= app.startTimeMs);
                                        %>
                                        <% if (canCheckIn) { %>
                                            <button onclick="updateStatus('<%= app.id %>', 'ON_GOING', this)"
                                                class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-lg hover:opacity-90 transition-opacity flex items-center justify-center gap-1 shadow-sm">
                                                <span class="material-symbols-outlined text-[18px]">login</span>
                                                Check-in
                                            </button>
                                        <% } else { %>
                                            <button disabled title="Check-in is only available at the scheduled appointment time"
                                                class="bg-slate-100 text-slate-400 border border-slate-200 px-4 py-2 rounded-lg font-label-lg flex items-center justify-center gap-1 cursor-not-allowed shadow-none">
                                                <span class="material-symbols-outlined text-[18px] text-slate-400">schedule</span>
                                                Check-in
                                            </button>
                                        <% } %>
                                        
                                        <!-- Dropdown Menu Trigger -->
                                        <div class="relative inline-block text-left appointment-dropdown-container">
                                            <button onclick="toggleDropdown(event, 'dropdown-<%= app.id %>')"
                                                class="px-2 py-2 border border-outline-variant rounded-lg hover:bg-surface-container transition-colors text-on-surface flex items-center justify-center">
                                                <span class="material-symbols-outlined text-[20px]">more_vert</span>
                                            </button>
                                            <div id="dropdown-<%= app.id %>" class="hidden absolute right-0 bottom-full mb-2 w-44 rounded-lg bg-white border border-outline-variant shadow-lg z-50 py-1.5">
                                                <button onclick="updateStatus('<%= app.id %>', 'NO_SHOW', this)"
                                                    class="w-full text-left px-4 py-2 text-label-lg text-on-surface hover:bg-slate-50 transition-colors flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-[18px] text-amber-500">person_off</span>
                                                    No Show
                                                </button>
                                                <button onclick="updateStatus('<%= app.id %>', 'CANCELLED', this)"
                                                    class="w-full text-left px-4 py-2 text-label-lg text-error hover:bg-slate-50 transition-colors flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    <% } else if (app.status === 'ON_GOING') { %>
                                        <!-- Primary Action: Complete -->
                                        <button onclick="updateStatus('<%= app.id %>', 'COMPLETED', this)"
                                            class="bg-emerald-600 text-white px-4 py-2 rounded-lg font-label-lg hover:bg-emerald-700 transition-colors flex items-center justify-center gap-1 shadow-sm">
                                            <span class="material-symbols-outlined text-[18px]">check_circle</span>
                                            Complete
                                        </button>
                                        
                                        <!-- Dropdown Menu Trigger -->
                                        <div class="relative inline-block text-left appointment-dropdown-container">
                                            <button onclick="toggleDropdown(event, 'dropdown-<%= app.id %>')"
                                                class="px-2 py-2 border border-outline-variant rounded-lg hover:bg-surface-container transition-colors text-on-surface flex items-center justify-center">
                                                <span class="material-symbols-outlined text-[20px]">more_vert</span>
                                            </button>
                                            <div id="dropdown-<%= app.id %>" class="hidden absolute right-0 bottom-full mb-2 w-44 rounded-lg bg-white border border-outline-variant shadow-lg z-50 py-1.5">
                                                <button onclick="updateStatus('<%= app.id %>', 'NO_SHOW', this)"
                                                    class="w-full text-left px-4 py-2 text-label-lg text-on-surface hover:bg-slate-50 transition-colors flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-[18px] text-amber-500">person_off</span>
                                                    No Show
                                                </button>
                                                <button onclick="updateStatus('<%= app.id %>', 'CANCELLED', this)"
                                                    class="w-full text-left px-4 py-2 text-label-lg text-error hover:bg-slate-50 transition-colors flex items-center gap-2">
                                                    <span class="material-symbols-outlined text-[18px]">cancel</span>
                                                    Cancel
                                                </button>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                            <% }); %>
                        </div>
                        
                        <!-- Empty State Container -->
                        <div id="empty-state-container" class="hidden flex flex-col items-center justify-center py-16 bg-surface-container-lowest rounded-xl card-shadow border border-outline-variant/30 text-center min-h-[300px] mt-6">
                            <span class="material-symbols-outlined text-5xl mb-4 text-on-surface-variant/40">calendar_today</span>
                            <h3 class="font-headline-sm text-headline-sm text-on-surface mb-2">No Appointments Found</h3>
                            <p class="font-body-md text-on-surface-variant max-w-sm">There are no appointments matching your selected date range and status filters.</p>
                        </div>
                    </section>
                </main>
        </div>
        <script src="/js/doctor/appointments.js"></script>

</body>

</html>