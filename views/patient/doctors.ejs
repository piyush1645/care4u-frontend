<!DOCTYPE html>
<html lang="en">
<head>
    <title>Find Doctors - MediCare</title>
    <%- include('partials/head') %>
</head>
<body class="text-slate-800 flex h-screen overflow-hidden">

<%- include('partials/sidebar') %>

<div class="flex-1 flex flex-col h-screen overflow-hidden bg-surface">
    <%- include('partials/topheader') %>

    <main class="flex-1 overflow-y-auto p-4 lg:p-8">
        <div class="max-w-7xl mx-auto space-y-6">

            <!-- Page Header -->
            <div>
                <h2 class="text-2xl font-bold text-slate-800">Find a Doctor</h2>
                <p class="text-slate-500 text-sm mt-1">Search specialists and book a consultation.</p>
            </div>

            <!-- Search Form -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
                <form id="searchForm" method="GET" action="/patient/doctors">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label for="searchQ" class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Name or Speciality</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[18px]">search</span>
                                <input id="searchQ" name="q" type="text" placeholder="e.g. Cardiologist, Dr. Smith" value="<%= locals.query?.q || '' %>"
                                    class="w-full bg-slate-50 border border-slate-200 rounded-xl pl-9 pr-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary/40 transition-all" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label for="searchHospital" class="text-xs font-semibold text-slate-500 uppercase tracking-wide">Hospital Branch</label>
                            <select id="searchHospital" name="hospitalId"
                                class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary/40 transition-all cursor-pointer">
                                <option value="">All Hospitals</option>
                                <% if (locals.hospitals && hospitals.length > 0) { %>
                                    <% hospitals.forEach(h => { %>
                                        <option value="<%= h.id.toString() %>" <%= locals.query?.hospitalId === h.id.toString() ? 'selected' : '' %>><%= h.branchName %></option>
                                    <% }) %>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <div class="mt-4 flex gap-3">
                        <button type="submit"
                            class="flex items-center gap-2 bg-primary text-white px-6 py-2.5 rounded-xl text-sm font-medium hover:bg-primary/90 transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">search</span> Search
                        </button>
                        <a href="/patient/doctors"
                            class="bg-slate-100 text-slate-600 px-4 py-2.5 rounded-xl text-sm font-medium hover:bg-slate-200 transition-colors">
                            Clear
                        </a>
                    </div>
                </form>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="<%= (doctorsData.items && doctorsData.items.length > 0) ? 'hidden' : '' %> text-center py-16 text-slate-400">
                <span class="material-symbols-outlined text-5xl block mb-3 opacity-40">person_search</span>
                <p class="font-bold text-slate-600 text-lg">No doctors found</p>
                <p class="text-sm mt-1">Try a different search term.</p>
            </div>

            <!-- Doctors Grid -->
            <div id="doctorsGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                <% if (doctorsData.items && doctorsData.items.length > 0) { %>
                    <% doctorsData.items.forEach(doctor => { %>
                        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex flex-col hover:shadow-md transition-shadow">
                            <div class="h-44 bg-slate-50 flex items-center justify-center overflow-hidden">
                                <img
                                    src="<%= doctor.profilePhoto || '/images/default-avatar.svg' %>"
                                    alt="Dr. <%= doctor.firstName %> <%= doctor.lastName %>"
                                    class="w-full h-full object-cover"
                                    onerror="this.src='/images/default-avatar.svg'"
                                />
                            </div>
                            <div class="p-5 flex flex-col gap-3 flex-1">
                                <div>
                                    <div class="flex flex-wrap gap-1.5 mb-2">
                                        <% doctor.specialities.slice(0, 2).forEach(s => { %>
                                            <span class="px-2 py-0.5 bg-blue-50 text-primary text-[11px] font-bold rounded-full uppercase"><%= s %></span>
                                        <% }) %>
                                    </div>
                                    <h3 class="font-bold text-slate-800">Dr. <%= doctor.firstName %> <%= doctor.lastName %></h3>
                                    <p class="text-sm text-slate-500 mt-0.5">
                                        <%= doctor.hospital.branchName %><%= doctor.hospital.city ? ' · ' + doctor.hospital.city : '' %>
                                    </p>
                                </div>
                                <div class="grid grid-cols-2 gap-2 text-center">
                                    <div class="bg-slate-50 border border-slate-100 rounded-xl p-2.5">
                                        <p class="text-[10px] text-slate-400 font-semibold uppercase">Experience</p>
                                        <p class="text-sm font-bold text-slate-700"><%= doctor.expereince %> yrs</p>
                                    </div>
                                    <div class="bg-slate-50 border border-slate-100 rounded-xl p-2.5">
                                        <p class="text-[10px] text-slate-400 font-semibold uppercase">Charges</p>
                                        <p class="text-sm font-bold text-slate-700">₹<%= doctor.charges %></p>
                                    </div>
                                </div>
                                <a href="/patient/doctors/<%= doctor.id %>"
                                    class="mt-auto w-full text-center bg-primary text-white py-2.5 rounded-xl text-sm font-medium hover:bg-primary/90 transition-colors">
                                    View Details & Book
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- Pagination -->
            <div id="paginationContainer" class="flex justify-center gap-2 pt-2">
                <% if (doctorsData.pagination && doctorsData.pagination.totalPages > 1) { %>
                    <div class="flex items-center gap-2">
                        <% for (let p = 1; p <= doctorsData.pagination.totalPages; p++) { %>
                            <% 
                                const urlParams = new URLSearchParams(query);
                                urlParams.set('page', p);
                                const isActive = p === parseInt(doctorsData.pagination.page || '1');
                            %>
                            <button onclick="changePage(<%= p %>)"
                                class="w-9 h-9 flex items-center justify-center rounded-xl text-sm font-semibold transition-all cursor-pointer
                                    <%= isActive
                                        ? 'bg-primary text-white shadow-sm'
                                        : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50'
                                    %>"
                            ><%= p %></button>
                        <% } %>
                    </div>
                <% } %>
            </div>

        </div>
    </main>
</div>

<script src="/js/patient/utils.js"></script>
<script src="/js/patient/api-client.js"></script>
<script src="/js/patient/fetchDoctors.js"></script>
</body>
</html>
