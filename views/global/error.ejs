<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title><%= title %> | MedCentral Portal</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config" src="/js/auth/tailwind-config.js"></script>
    <link rel="stylesheet" href="/css/global/error.css">
</head>

<body class="bg-surface-container-low min-h-screen flex flex-col justify-between overflow-x-hidden relative">
    <!-- Visual background motifs -->
    <div class="absolute inset-0 z-0 opacity-30 pointer-events-none">
        <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-primary-fixed/20 blur-[120px]"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-error-container/20 blur-[120px]"></div>
    </div>

    <!-- Header / Brand -->
    <header class="w-full h-16 bg-surface-container-lowest shadow-sm flex items-center justify-between px-margin-desktop z-10">
        <div class="flex items-center gap-md">
            <span class="material-symbols-outlined text-primary text-[28px]">medical_services</span>
            <span class="font-headline-sm text-headline-sm font-bold text-primary">MedCentral Portal</span>
        </div>
        <div class="flex items-center gap-md">
            <a class="text-on-surface-variant hover:text-primary transition-colors font-label-md" href="/">Home</a>
            <a class="bg-primary text-on-primary px-4 py-2 rounded-lg font-label-md hover:shadow-md transition-all active:scale-95" href="/auth/login">Login</a>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 flex flex-col items-center justify-center p-xl z-10">
        <div class="w-full max-w-2xl bg-surface-container-lowest border border-outline-variant/30 rounded-3xl p-xl md:p-2xl glow-effect text-center space-y-xl animate-in fade-in slide-in-from-bottom-6 duration-700">
            <!-- Animated Error Graphic -->
            <div class="relative inline-flex items-center justify-center">
                <div class="absolute w-44 h-44 rounded-full bg-error-container/10 animate-ping"></div>
                <div class="absolute w-36 h-36 rounded-full bg-primary-fixed-dim/10 animate-pulse"></div>
                <div class="w-28 h-28 rounded-2xl bg-surface-container flex items-center justify-center border border-outline-variant shadow-inner relative z-10">
                    <% if (statusCode === 404) { %>
                        <span class="material-symbols-outlined text-[64px] text-primary">search_off</span>
                    <% } else if (statusCode === 403) { %>
                        <span class="material-symbols-outlined text-[64px] text-error">gpp_bad</span>
                    <% } else { %>
                        <span class="material-symbols-outlined text-[64px] text-error">warning</span>
                    <% } %>
                </div>
            </div>

            <!-- Error Info -->
            <div class="space-y-sm">
                <h1 class="font-display-lg text-display-lg font-extrabold error-code-gradient tracking-tight leading-none">
                    <%= statusCode %>
                </h1>
                <h2 class="font-headline-md text-headline-md text-on-surface font-bold">
                    <%= title %>
                </h2>
                <p class="font-body-lg text-body-lg text-on-surface-variant max-w-md mx-auto leading-relaxed">
                    <%= message %>
                </p>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-md justify-center pt-md">
                <button onclick="window.history.back()" class="px-xl py-3.5 border-2 border-primary text-primary font-label-lg text-label-lg rounded-xl hover:bg-primary/5 active:scale-[0.98] transition-all flex items-center justify-center gap-sm">
                    <span class="material-symbols-outlined">arrow_back</span>
                    Go Back
                </button>
                <a href="/" class="px-xl py-3.5 bg-primary hover:bg-primary/90 text-on-primary font-label-lg text-label-lg rounded-xl shadow-md active:scale-[0.98] transition-all flex items-center justify-center gap-sm">
                    <span class="material-symbols-outlined">home</span>
                    Go to Homepage
                </a>
            </div>

            <!-- Additional Help -->
            <div class="pt-lg border-t border-outline-variant/30 text-center">
                <p class="text-label-sm text-outline">
                    Need immediate assistance? <a href="#" class="text-primary font-bold hover:underline">Contact System Administrator</a> or call support.
                </p>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full py-md bg-surface-container-lowest border-t border-outline-variant z-10">
        <div class="flex flex-col md:flex-row justify-between items-center px-margin-desktop w-full mx-auto max-w-7xl gap-sm">
            <span class="font-label-sm text-label-sm text-on-surface-variant text-center md:text-left">
                © 2024 MedCentral Healthcare Systems. All rights reserved. Confidential Clinician Portal.
            </span>
            <div class="flex gap-md font-label-sm text-label-sm text-on-surface-variant">
                <span class="text-secondary font-bold flex items-center gap-xs">
                    <span class="material-symbols-outlined text-[16px]">verified_user</span>
                    HIPAA Compliant
                </span>
                <span class="text-outline">|</span>
                <span class="text-outline">Session Secured</span>
            </div>
        </div>
    </footer>
</body>

</html>
