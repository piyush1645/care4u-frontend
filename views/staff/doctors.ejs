<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <title>Staff Find Doctors | Care4U</title>
    <%- include('partials/head') %>
</head>
<body class="bg-[#F4F5F7] text-on-surface flex h-screen overflow-hidden">

    <%- include('partials/sidebar') %>

    <div class="flex-1 flex flex-col h-screen overflow-hidden">
        <%- include('partials/topheader') %>

        <main class="flex-1 overflow-y-auto p-md max-w-full overflow-x-hidden ml-0 lg:ml-64">
            <!-- Page Header -->
            <div class="mb-lg">
                <h2 class="text-2xl font-bold text-on-surface">Find a Doctor</h2>
                <p class="text-sm text-on-surface-variant mt-1" id="bookingForPatientText">Search specialists to book an appointment.</p>
            </div>

            <!-- Search Form -->
            <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 p-md mb-lg">
                <form id="searchForm" method="GET" action="/staff/doctors">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="flex flex-col gap-1.5">
                            <label for="searchQ" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Name or Speciality</label>
                            <div class="relative">
                                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
                                <input id="searchQ" name="q" type="text" placeholder="e.g. Cardiologist, Dr. Smith" value="<%= locals.query?.q || '' %>"
                                    class="w-full bg-surface-container-lowest border border-outline-variant rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                            </div>
                        </div>
                        <div class="flex flex-col gap-1.5">
                            <label for="searchSpeciality" class="text-xs font-semibold text-on-surface-variant uppercase tracking-wide">Speciality</label>
                            <input id="searchSpeciality" name="speciality" type="text" placeholder="e.g. Neurology" value="<%= locals.query?.speciality || '' %>"
                                class="bg-surface-container-lowest border border-outline-variant rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all" />
                        </div>
                    </div>
                    <div class="mt-4 flex gap-3">
                        <button type="submit"
                            class="flex items-center gap-2 bg-primary text-white px-6 py-2 rounded-lg text-sm font-semibold hover:bg-primary/90 transition-colors shadow-sm">
                            <span class="material-symbols-outlined text-[18px]">search</span> Search
                        </button>
                        <a href="/staff/doctors"
                            class="bg-surface-container text-on-surface px-4 py-2 rounded-lg text-sm font-semibold hover:bg-outline-variant/30 transition-colors">
                            Clear
                        </a>
                    </div>
                </form>
            </div>

            <!-- Empty State -->
            <% 
              let items = doctorsData.items || doctorsData.docs || [];
            %>
            <div id="emptyState" class="<%= (items && items.length > 0) ? 'hidden' : '' %> text-center py-16 text-on-surface-variant">
                <span class="material-symbols-outlined text-5xl block mb-3 opacity-40">person_search</span>
                <p class="font-bold text-on-surface text-lg">No doctors found</p>
                <p class="text-sm mt-1">Try a different search term.</p>
            </div>

            <!-- Doctors Grid -->
            <div id="doctorsGrid" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-5">
                <% if (items && items.length > 0) { %>
                    <% items.forEach(doctor => { %>
                        <%
                            // Normalize name: patient endpoint returns firstName/lastName, staff fallback returns fullName
                            const doctorDisplayName = doctor.fullName || ('Dr. ' + (doctor.firstName || '') + ' ' + (doctor.lastName || '')).trim();
                            // Normalize specialities: patient endpoint returns speciality[{name}], staff endpoint returns specialities[]
                            const doctorSpecs = doctor.specialities
                                ? (Array.isArray(doctor.specialities) ? doctor.specialities : [doctor.specialities])
                                : (doctor.speciality ? doctor.speciality.map(s => s.name) : []);
                        %>
                        <div class="bg-white rounded-xl shadow-sm border border-outline-variant/30 overflow-hidden flex flex-col hover:shadow-md transition-shadow">
                            <div class="h-40 bg-surface-container-low flex items-center justify-center overflow-hidden">
                                <img
                                    src="<%= doctor.profilePhoto || '/images/default-avatar.svg' %>"
                                    alt="<%= doctorDisplayName %>"
                                    class="w-full h-full object-cover"
                                    onerror="this.src='/images/default-avatar.svg'"
                                />
                            </div>
                            <div class="p-4 flex flex-col gap-3 flex-1">
                                <div>
                                    <div class="flex flex-wrap gap-1.5 mb-2">
                                        <% doctorSpecs.slice(0, 2).forEach(s => { %>
                                            <span class="px-2 py-0.5 bg-primary/10 text-primary text-[11px] font-bold rounded-full uppercase"><%= s %></span>
                                        <% }) %>
                                    </div>
                                    <h3 class="font-bold text-on-surface"><%= doctorDisplayName %></h3>
                                    <p class="text-sm text-on-surface-variant mt-0.5">
                                        <%
                                            const hosp = doctor.hospital;
                                            const branchName = hosp ? (hosp.branchName || '') : '';
                                            const city = hosp ? (hosp.address ? hosp.address.city : (hosp.city || '')) : '';
                                        %>
                                        <%= branchName %><%= city ? ' · ' + city : '' %>
                                    </p>
                                </div>
                                <div class="grid grid-cols-2 gap-2 text-center">
                                    <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-2.5">
                                        <p class="text-[10px] text-outline font-semibold uppercase">Experience</p>
                                        <p class="text-sm font-bold text-on-surface"><%= doctor.expereince || doctor.experience || '0' %> yrs</p>
                                    </div>
                                    <div class="bg-surface-container-lowest border border-outline-variant/50 rounded-lg p-2.5">
                                        <p class="text-[10px] text-outline font-semibold uppercase">Charges</p>
                                        <p class="text-sm font-bold text-on-surface">₹<%= doctor.charges || '0' %></p>
                                    </div>
                                </div>
                                <a href="/staff/doctors/<%= doctor.id || doctor._id %>"
                                    class="mt-auto w-full text-center bg-primary text-white py-2.5 rounded-lg text-sm font-semibold hover:bg-primary/90 transition-colors">
                                    Select Doctor
                                </a>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- Pagination -->
            <div id="paginationContainer" class="flex justify-center gap-2 pt-6 pb-4">
                <% if (doctorsData.pagination && doctorsData.pagination.totalPages > 1) { %>
                    <div class="flex items-center gap-2">
                        <% for (let p = 1; p <= doctorsData.pagination.totalPages; p++) { %>
                            <% 
                                const urlParams = new URLSearchParams(query);
                                urlParams.set('page', p);
                                const isActive = p === parseInt(doctorsData.pagination.page || '1');
                            %>
                            <button onclick="changePage(<%= p %>)"
                                class="w-9 h-9 flex items-center justify-center rounded-lg text-sm font-semibold transition-all cursor-pointer
                                    <%= isActive
                                        ? 'bg-primary text-white shadow-sm'
                                        : 'bg-white border border-outline-variant text-on-surface-variant hover:bg-surface-container'
                                    %>"
                            ><%= p %></button>
                        <% } %>
                    </div>
                <% } %>
            </div>

        </main>
    </div>
    
    <script src="/js/staff/doctors.js"></script>
</body>
</html>
