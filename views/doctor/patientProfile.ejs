<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>MedCentral | Patient Profile & History</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <script src="/js/doctor/tailwind-config.js"></script>
    <link rel="stylesheet" href="/css/doctor/common.css">
</head>

<body class="bg-background text-on-background flex h-screen overflow-hidden">
    <!-- SideNavBar Anchor -->
    <%- include("partials/leftNavBar.ejs") %>

    <!-- Main Wrapper -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden w-full">
        <!-- TopNavBar Anchor -->
        <%- include("partials/topHeader.ejs") %>
        
        <!-- Main Content Area -->
        <main class="p-4 lg:p-8 flex flex-col gap-8 flex-1 overflow-y-auto bg-slate-50">
            <!-- Back button and title -->
            <div class="flex items-center gap-4">
                <a href="/doctor/appointments" class="inline-flex items-center justify-center p-2 rounded-full bg-white hover:bg-slate-100 text-slate-600 transition-colors border border-slate-200">
                    <span class="material-symbols-outlined">arrow_back</span>
                </a>
                <div>
                    <h2 class="text-2xl font-bold text-slate-800">Patient Profile</h2>
                    <p class="text-sm text-slate-500">Detailed medical history and records</p>
                </div>
            </div>

            <!-- Patient Profile & Key Stats Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Patient Bio Card -->
                <div class="lg:col-span-2 bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col md:flex-row gap-6 items-start md:items-center">
                    <div class="w-24 h-24 rounded-full overflow-hidden bg-blue-50 border-4 border-blue-100/50 shrink-0 flex items-center justify-center">
                        <img src="<%= patient.profilePhoto || '/images/default-avatar.svg' %>" onerror="this.onerror=null; this.src='/images/default-avatar.svg';" alt="<%= patient.firstName %>" class="w-full h-full object-cover">
                    </div>
                    <div class="space-y-2 flex-1">
                        <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-xl font-bold text-slate-800">
                                <%= [patient.firstName, patient.middleName, patient.lastName].filter(Boolean).join(' ') %>
                            </h3>
                            <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-600">ID: #MC-<%= patient.id %></span>
                        </div>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-2">
                            <div>
                                <span class="block text-xs text-slate-400 font-medium uppercase tracking-wider">Gender</span>
                                <span class="text-sm font-semibold text-slate-700 capitalize"><%= patient.gender?.toLowerCase() || 'N/A' %></span>
                            </div>
                            <div>
                                <span class="block text-xs text-slate-400 font-medium uppercase tracking-wider">Age / DOB</span>
                                <span class="text-sm font-semibold text-slate-700">
                                    <% if (patient.dateOfBirth) { %>
                                        <%= new Date().getFullYear() - new Date(patient.dateOfBirth).getFullYear() %> yrs (<%= new Date(patient.dateOfBirth).toLocaleDateString('en-IN', {day: 'numeric', month: 'short'}) %>)
                                    <% } else { %>
                                        N/A
                                    <% } %>
                                </span>
                            </div>
                            <div>
                                <span class="block text-xs text-slate-400 font-medium uppercase tracking-wider">Blood Group</span>
                                <span class="text-sm font-semibold text-red-600"><%= patient.bloodGroup || 'N/A' %></span>
                            </div>
                            <div>
                                <span class="block text-xs text-slate-400 font-medium uppercase tracking-wider">Contact</span>
                                <span class="text-sm font-semibold text-slate-700"><%= patient.mobile || 'N/A' %></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Stats / Contact Card -->
                <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm flex flex-col justify-between gap-4">
                    <div class="grid grid-cols-2 gap-4">
                        <div class="bg-blue-50/50 p-4 rounded-xl border border-blue-100/30">
                            <span class="block text-xs text-slate-500 font-medium">Total Consultations</span>
                            <span class="text-2xl font-bold text-[#002868] mt-1 block"><%= appointments.length %></span>
                        </div>
                        <div class="bg-emerald-50/50 p-4 rounded-xl border border-emerald-100/30">
                            <span class="block text-xs text-slate-500 font-medium">Last Visit</span>
                            <span class="text-sm font-semibold text-emerald-700 mt-2 block">
                                <% 
                                    let lastVisit = 'No visits yet';
                                    const pastAppts = appointments.filter(a => new Date(a.appointmentDate) < new Date());
                                    if (pastAppts.length > 0) {
                                        lastVisit = new Date(pastAppts[0].appointmentDate).toLocaleDateString('en-IN', {
                                            day: 'numeric',
                                            month: 'short',
                                            year: 'numeric'
                                        });
                                    }
                                %>
                                <%= lastVisit %>
                            </span>
                        </div>
                    </div>
                    <div class="border-t border-slate-100 pt-3 flex flex-col gap-2">
                        <div class="flex items-center gap-2 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-[16px]">mail</span>
                            <span><%= patient.email %></span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-slate-500">
                            <span class="material-symbols-outlined text-[16px]">call</span>
                            <span><%= patient.mobile %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Clinical & Meeting History Timeline -->
            <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
                <h3 class="text-lg font-bold text-slate-800 mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">history</span>
                    Consultation & Meeting History
                </h3>

                <% if (appointments && appointments.length > 0) { %>
                    <div class="relative border-l-2 border-slate-100 ml-4 pl-6 space-y-8">
                        <% appointments.forEach((appt, idx) => { %>
                            <!-- Timeline item -->
                            <div class="relative">
                                <!-- Dot indicator -->
                                <span class="absolute -left-[31px] top-1.5 bg-white border-2 border-primary rounded-full w-4 h-4 z-10"></span>
                                
                                <div class="bg-slate-50/50 rounded-xl p-5 border border-slate-100 hover:shadow-md hover:bg-white hover:border-slate-200 transition-all">
                                    <div class="flex flex-wrap justify-between items-start gap-4 mb-3">
                                        <div>
                                            <span class="text-xs text-slate-400 font-semibold uppercase tracking-wider block">
                                                <%= new Date(appt.appointmentDate).toLocaleDateString('en-IN', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
                                            </span>
                                            <div class="flex items-center gap-2 mt-1">
                                                <span class="material-symbols-outlined text-[16px] text-slate-400">schedule</span>
                                                <span class="text-sm font-semibold text-slate-700">
                                                    <%= new Date(appt.appointmentStartTime).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true }) %> - 
                                                    <%= new Date(appt.appointmentEndTime).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit', hour12: true }) %>
                                                </span>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <span class="text-xs px-2.5 py-0.5 rounded-full font-medium bg-blue-50 text-blue-700 border border-blue-100"><%= appt.hospital?.branchName || 'MediCare Clinic' %></span>
                                            <span class="text-xs px-2.5 py-0.5 rounded-full font-medium 
                                                <% if (appt.status === 'COMPLETED' || appt.status === 'Confirmed') { %>
                                                    bg-emerald-50 text-emerald-700 border border-emerald-100
                                                <% } else if (appt.status === 'CANCELLED') { %>
                                                    bg-rose-50 text-rose-700 border border-rose-100
                                                <% } else { %>
                                                    bg-amber-50 text-amber-700 border border-amber-100
                                                <% } %>
                                            "><%= appt.status %></span>
                                        </div>
                                    </div>

                                    <!-- Consult Details -->
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t border-slate-100">
                                        <div>
                                            <span class="block text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1">Reason / Complaint</span>
                                            <p class="text-sm text-slate-700 font-medium"><%= appt.reason || 'General Consultation' %></p>
                                        </div>
                                        
                                        <!-- Suggestions and Prescription -->
                                        <div>
                                            <span class="block text-xs text-slate-400 font-semibold uppercase tracking-wider mb-1">Clinical Suggestions & Medicines</span>
                                            <% if (appt.prescription) { %>
                                                <p class="text-sm text-slate-700 whitespace-pre-line"><%= appt.prescription.precautions %></p>
                                                <% if (appt.prescription.attachment && appt.prescription.attachment.length > 0) { %>
                                                    <div class="mt-3 flex flex-wrap gap-2">
                                                        <% appt.prescription.attachment.forEach((file) => { %>
                                                            <a href="<%= file.url %>" target="_blank" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-primary-fixed text-primary hover:opacity-90 transition-opacity">
                                                                <span class="material-symbols-outlined text-[16px]">download</span>
                                                                Attached Prescription
                                                            </a>
                                                        <% }); %>
                                                    </div>
                                                <% } %>
                                            <% } else { %>
                                                <p class="text-sm text-slate-400 italic">No suggestion notes or medicines recorded for this visit.</p>
                                            <% } %>

                                            <% if (new Date() > new Date(appt.appointmentEndTime) && appt.status !== 'CANCELLED') { %>
                                                <div class="mt-4 border-t border-slate-100 pt-3">
                                                    <span class="block text-xs text-slate-400 font-semibold uppercase tracking-wider mb-2">Upload Prescription Photo</span>
                                                    <form onsubmit="uploadPrescription(event, '<%= appt.id %>')" class="flex items-center gap-3">
                                                        <label class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors border border-slate-200">
                                                            <span class="material-symbols-outlined text-[16px]">upload_file</span>
                                                            Choose File
                                                            <input type="file" name="file" accept="image/*" class="hidden" required onchange="updateFileName(this)">
                                                        </label>
                                                        <span class="text-xs text-slate-500 file-name-text">No file chosen</span>
                                                        <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#002868] hover:bg-[#001f52] text-white transition-colors disabled:opacity-50" disabled>
                                                            Upload
                                                        </button>
                                                    </form>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="flex flex-col items-center justify-center py-16 text-slate-400">
                        <span class="material-symbols-outlined text-6xl mb-4 opacity-20">history</span>
                        <p class="text-base font-medium">No consultations recorded for this patient.</p>
                        <p class="text-sm opacity-80 mt-1">This patient does not have any appointments with you.</p>
                    </div>
                <% } %>
            </div>
        </main>
    </div>
    <script src="/js/doctor/patientProfile.js"></script>
</body>

</html>
