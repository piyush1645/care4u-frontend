<!DOCTYPE html>

<html class="light" lang="en">

<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Doctor Management | MediFlow Admin</title>
    <link rel="stylesheet" href="/css/output.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap"
        rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="/css/admin/common.css">
    <link rel="stylesheet" href="/css/admin/doctors.css">
    <link rel="stylesheet" href="/css/admin/modal.css">
</head>

<body class="bg-background text-on-surface">
    <%- include('../partial/navBar') %>
        <header
            class="fixed top-0 right-0 w-full lg:w-[calc(100%-260px)] h-20 bg-surface-container-lowest dark:bg-surface-dim border-b border-outline-variant flex items-center justify-between px-md z-40 backdrop-blur-sm">
            <div class="flex items-center">
                <button onclick="toggleSidebar()" class="lg:hidden p-2 text-slate-600 hover:bg-slate-100 rounded-lg mr-2 flex items-center justify-center">
                    <span class="material-symbols-outlined text-[24px]">menu</span>
                </button>
                <h2 class="font-headline-lg text-headline-md font-bold text-primary">
                    Doctor Management
                </h2>
            </div>
            <button
                class="flex items-center gap-2 bg-primary text-on-primary px-md py-3 rounded-xl shadow-md hover:bg-primary-container hover:shadow-lg transition-all duration-200 active:scale-95">
                <span class="material-symbols-outlined text-[20px]">
                    person_add
                </span>

                <span class="font-label-md text-label-md">
                    Add Doctor
                </span>
            </button>

        </header>

        <main class="ml-0 lg:ml-[260px] pt-24 p-md min-h-screen">

            <!-- Filter & Stats Bento Grid -->
            <div class="sticky grid grid-cols-1 md:grid-cols-12 gap-md mb-md mt-6">
                <!-- Stats Card 1 -->
                <div
                    class="md:col-span-3 bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30">
                    <div class="flex justify-between items-start mb-2">
                        <div class="p-2 bg-primary-container/10 rounded-lg">
                            <span class="material-symbols-outlined text-primary" data-icon="groups">groups</span>
                        </div>
                    </div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Total
                        Doctors
                    </p>
                    <p class="font-headline-md text-headline-md text-on-surface font-bold">
                        <%= counts.doctorCount %>
                    </p>
                </div>
                <!-- Stats Card 2 -->
                <div
                    class="md:col-span-3 bg-surface-container-lowest p-md rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30">
                    <div class="flex justify-between items-start mb-2">
                        <div class="p-2 bg-secondary-container/10 rounded-lg">
                            <span class="material-symbols-outlined text-secondary"
                                data-icon="check_circle">check_circle</span>
                        </div>
                        <span class="text-on-surface-variant font-label-sm text-label-sm">Active Now</span>
                    </div>
                    <p class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">Active
                        Doctors
                    </p>
                    <p class="font-headline-md text-headline-md text-on-surface font-bold">
                        <%= counts.availableDoctorCount %>
                    </p>
                </div>
            </div>
            <!-- Comprehensive Doctor Table -->
            <div class="max-h-[650px]  bg-surface-container-lowest rounded-xl shadow-[0px_4px_12px_rgba(0,0,0,0.05)] border border-outline-variant/30           overflow-hidden"
                style="max-height: 650px !important;">

                <div class="flex justify-end p-4 gap-3">
                    <form action="/admin/doctors" method="GET">
                        <input type="text" name="searchString" value="<%= searchString || '' %>" placeholder="Search Doctor"
                            class="border border-outline-variant rounded-lg px-3 py-2 mr-3 w-80">
                
                        <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg">
                            Search
                        </button>
                    </form>
                
                    <a href="/admin/doctors" class="px-4 py-2 bg-red-500 text-white rounded-lg inline-flex items-center">
                        Reset
                    </a>
                </div>

                <div class=" max-h-[650px] overflow-y-auto">
                    <table class="w-full text-left table-fixed border-collapse">
                        <thead class="bg-surface-container-low border-b border-outline-variant sticky top-0">
                            <tr>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Doctor
                                    Name
                                </th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Specialty
                                    /
                                    Dept
                                </th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Contact
                                    Information</th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant">Status
                                </th>
                                <th class="px-md py-4 font-label-md text-label-md text-on-surface-variant text-right">
                                    Actions</th>
                            </tr>
                        </thead>
                        <tbody id="displayDoctorDetails" class="divide-y divide-outline-variant/30">
                            <% data.forEach( doctor=> {
                                const specialityString = doctor.speciality.map( s => s.name).join(", ") %>
                                <tr class="doctor-row transition-colors" onclick="displayDoctorProfile(<%= doctor.id %>)">
                                    <td class="px-md py-4">
                                        <div class="flex items-center space-x-3">
                                            <img alt="Doctor Avatar"
                                                class="w-10 h-10 rounded-full object-cover shadow-sm"
                                                src="<%= doctor.profilePhoto || '/images/default-avatar.svg' %>"
                                                onerror="this.onerror=null; this.src='/images/default-avatar.svg';" />
                                            <div>
                                                <p class="font-body-md text-body-md font-semibold text-on-surface">
                                                    <%= doctor.firstName + " " + doctor.lastName %>
                                                </p>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="px-md py-4">
                                        <div>
                                            <p class="font-body-sm text-body-sm text-on-surface">
                                                <%= specialityString %>
                                            </p>
                                        </div>
                                    </td>
                                    <td class="px-md py-4">
                                        <div>
                                            <p class="font-body-sm text-body-sm text-on-surface flex items-center">
                                                <span
                                                    class="material-symbols-outlined text-[16px] mr-1 text-on-surface-variant"
                                                    data-icon="mail">mail</span>
                                                <%= doctor.credential.email %>
                                            </p>
                                            <p
                                                class="font-label-sm text-label-sm text-on-surface-variant flex items-center">
                                                <span
                                                    class="material-symbols-outlined text-[16px] mr-1 text-on-surface-variant"
                                                    data-icon="phone">phone</span>
                                                <%= doctor.credential.mobile %>
                                            </p>
                                        </div>
                                    </td>
                                    <td class="px-md py-4">
                                        <span class="status-pill bg-blue-200 inline-flex items-center">
                                            <%= doctor.credential.isActive ? "Active" : "DeActive" %>
                                        </span>
                                    </td>
                                    <td class="px-md py-4 text-right">
                                        <div class="flex justify-end space-x-2">
                                            <button
                                                class="p-2 text-primary hover:bg-primary/5 rounded-lg transition-colors"
                                                title="Deactivate Doctor"
                                                onclick="event.stopPropagation(); deleteDoctor(<%= doctor.credential.id %>, 'Dr. <%= doctor.firstName %> <%= doctor.lastName %>')">
                                                <span class="material-symbols-outlined text-[20px]" data-icon="delete">delete</span>
                                            </button>
                                            <button
                                                class="p-2 text-primary hover:bg-primary/5 rounded-lg transition-colors"
                                                title="Edit"
                                                onclick="event.stopPropagation(); editDoctorProfile(<%= doctor.id %>)">
                                                <span class="material-symbols-outlined text-[20px]" data-icon="edit">edit</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% });%>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
        
        <!-- Deactivate Doctor Modal -->
        <div id="deactivateDoctorModal" class="custom-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="deactivateDoctorModalTitle">
            <div class="custom-modal-card">
                <!-- Header accent -->
                <div class="custom-modal-header-accent"></div>

                <div class="custom-modal-body">
                    <div class="custom-modal-icon-wrapper">
                        <span class="material-symbols-outlined custom-modal-icon">person_off</span>
                    </div>
                    
                    <h3 id="deactivateDoctorModalTitle" class="custom-modal-title">
                        Deactivate Doctor Account
                    </h3>
                    
                    <p class="custom-modal-text">
                        Are you sure you want to deactivate
                        <span id="deactivateDoctorName" style="font-weight: 600; color: #0f172a;">this doctor</span>?
                        They will no longer be able to sign in or manage their schedule.
                    </p>

                    <div class="custom-modal-warning-box">
                        <span class="material-symbols-outlined custom-modal-warning-icon">info</span>
                        <p class="custom-modal-warning-text">
                            This action disables login access and patient booking capabilities for this doctor. The record remains in the system for history.
                        </p>
                    </div>

                    <div class="custom-modal-actions">
                        <button type="button" id="cancelDeactivateDoctor" class="custom-modal-btn custom-modal-btn-cancel">
                            Cancel
                        </button>
                        <button type="button" id="confirmDeactivateBtn" class="custom-modal-btn custom-modal-btn-confirm">
                            <span class="material-symbols-outlined" style="font-size: 18px;">block</span>
                            Deactivate Doctor
                        </button>
                    </div>
                </div>
            </div>
        </div>
        
        <script src="/js/admin/dashboard.js"></script>
        <script src="/js/admin/doctors.js"></script>
</body>

</html>