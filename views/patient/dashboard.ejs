<!DOCTYPE html>
<html lang="en">
<head>
    <title>Patient Dashboard - MediCare</title>
    <%- include('partials/head') %>
</head>
<body class="text-slate-800 flex h-screen overflow-hidden">

<%- include('partials/sidebar') %>

<div class="flex-1 flex flex-col h-screen overflow-hidden bg-surface">
    <%- include('partials/topheader') %>

    <main class="flex-1 overflow-y-auto p-4 lg:p-8">
        <div class="max-w-7xl mx-auto space-y-6">

            <!-- Welcome -->
            <div>
                <h2 id="welcomeHeading" class="text-2xl font-bold text-slate-800">Welcome back, <%= dashboard.patient.firstName %> 👋</h2>
                <p class="text-slate-500 text-sm mt-1">Here's a summary of your health activity.</p>
            </div>

            <!-- Stats Row -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <a href="/patient/appointments" class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex items-center gap-4 hover:shadow-md hover:border-primary/30 transition-all cursor-pointer">
                    <div class="w-12 h-12 rounded-full bg-blue-50 text-primary flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined">analytics</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold" id="totalVisits"><%= dashboard.stats.totalVisits %></p>
                        <p class="text-xs text-slate-500 uppercase tracking-wide font-medium">Total Visits</p>
                    </div>
                </a>
                <a href="/patient/appointments" class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex items-center gap-4 hover:shadow-md hover:border-emerald-300/30 transition-all cursor-pointer">
                    <div class="w-12 h-12 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined">event_available</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold" id="upcomingCount"><%= String(dashboard.stats.upcomingCount).padStart(2, "0") %></p>
                        <p class="text-xs text-slate-500 uppercase tracking-wide font-medium">Upcoming</p>
                    </div>
                </a>
                <a href="/patient/appointments" class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex items-center gap-4 hover:shadow-md hover:border-red-300/30 transition-all cursor-pointer">
                    <div class="w-12 h-12 rounded-full bg-red-50 text-red-500 flex items-center justify-center shrink-0">
                        <span class="material-symbols-outlined">event_busy</span>
                    </div>
                    <div>
                        <p class="text-2xl font-bold" id="cancelledCount"><%= String(dashboard.stats.cancelledCount).padStart(2, "0") %></p>
                        <p class="text-xs text-slate-500 uppercase tracking-wide font-medium">Cancelled</p>
                    </div>
                </a>
            </div>

            <!-- Next Appointment + Quick Actions -->
            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">

                <!-- Next Appointment -->
                <div class="xl:col-span-2 bg-white rounded-2xl shadow-sm border border-slate-100">
                    <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
                        <h3 class="font-bold text-lg text-slate-800">Next Appointment</h3>
                        <a href="/patient/appointments" class="text-primary text-sm font-medium hover:underline">View All</a>
                    </div>
                    <div class="p-6">
                        <!-- No appointment -->
                        <div id="noAppointmentMsg" class="<%= dashboard.nextAppointment ? 'hidden' : '' %> flex flex-col items-center justify-center py-10 text-slate-400">
                            <span class="material-symbols-outlined text-5xl mb-3 opacity-30">event_busy</span>
                            <p class="text-sm">No upcoming appointments.</p>
                            <a href="/patient/doctors" class="mt-4 bg-primary text-white px-5 py-2 rounded-xl text-sm font-medium hover:bg-primary/90 transition-colors">
                                Book Now
                            </a>
                        </div>
                        <!-- Appointment card -->
                        <% if (dashboard.nextAppointment) { %>
                        <div id="nextAppointmentSection" class="flex flex-col sm:flex-row gap-6 items-start">
                            <img id="doctorPhoto" src="<%= dashboard.nextAppointment.doctor.profilePhoto || '/images/default-avatar.svg' %>" onerror="this.onerror=null; this.src='/images/default-avatar.svg';" alt="Dr. <%= dashboard.nextAppointment.doctor.fullName %>"
                                class="w-24 h-24 rounded-2xl object-cover border border-slate-200 shrink-0" />
                            <div class="flex-1 space-y-3">
                                <div>
                                    <span id="speciality" class="inline-block text-xs bg-blue-50 text-primary px-2.5 py-1 rounded-full font-semibold uppercase tracking-wide mb-1"><%= dashboard.nextAppointment.doctor.specialities[0] || 'General' %></span>
                                    <h4 id="doctorName" class="text-xl font-bold text-slate-800">Dr. <%= dashboard.nextAppointment.doctor.fullName %></h4>
                                    <p id="experience" class="text-sm text-slate-500"><%= dashboard.nextAppointment.doctor.experience %> years exp.</p>
                                    <p id="hospitalName" class="text-sm text-slate-500 mt-0.5"><%= dashboard.nextAppointment.hospital.branchName %> — <%= dashboard.nextAppointment.hospital.groupName %></p>
                                </div>
                                <div class="flex gap-3 flex-wrap">
                                    <div class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2">
                                        <p class="text-xs text-slate-400 font-medium">Date</p>
                                        <p id="apptDate" class="text-sm font-semibold text-slate-700 mt-0.5">
                                            <%= new Date(dashboard.nextAppointment.appointmentDate).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                                        </p>
                                    </div>
                                    <div class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2">
                                        <p class="text-xs text-slate-400 font-medium">Time</p>
                                        <p id="apptTime" class="text-sm font-semibold text-slate-700 mt-0.5">
                                            <%= new Date(dashboard.nextAppointment.appointmentStartTime).toLocaleTimeString("en-IN", { hour: "2-digit", minute: "2-digit", hour12: true }) %>
                                        </p>
                                    </div>
                                    <div class="bg-slate-50 border border-slate-200 rounded-xl px-4 py-2">
                                        <p class="text-xs text-slate-400 font-medium">Type</p>
                                        <p id="apptType" class="text-sm font-semibold text-slate-700 mt-0.5">
                                            <%= dashboard.nextAppointment.type === "ONLINE" ? "Online (Video)" : "In Person" %>
                                        </p>
                                    </div>
                                </div>
                                <div class="flex gap-3 pt-1 items-center flex-wrap">
                                    <a href="/patient/appointments" class="bg-primary text-white px-5 py-2 rounded-xl text-sm font-medium hover:bg-primary/90 transition-colors">
                                        Manage
                                    </a>
                                    <button id="rescheduleBtn" class="bg-slate-100 text-slate-600 px-5 py-2 rounded-xl text-sm font-medium hover:bg-slate-200 transition-colors">
                                        Reschedule
                                    </button>
                                    <div id="dashboardMeetingContainer" class="<%= dashboard.nextAppointment.type === 'ONLINE' ? '' : 'hidden' %>" data-appt-id="<%= dashboard.nextAppointment.id %>" data-appt-type="<%= dashboard.nextAppointment.type %>"></div>
                                </div>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <!-- Quick Actions -->
                <div class="space-y-4">
                    <a href="/patient/doctors"
                        class="flex items-center gap-4 bg-primary text-white rounded-2xl p-5 shadow-sm hover:bg-primary/90 transition-colors">
                        <div class="w-10 h-10 bg-white/20 rounded-xl flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined">person_search</span>
                        </div>
                        <div>
                            <p class="font-bold text-base">Find a Doctor</p>
                            <p class="text-xs text-white/70">Browse & book specialists</p>
                        </div>
                    </a>
                    <a href="/patient/appointments"
                        class="flex items-center gap-4 bg-white border border-slate-100 rounded-2xl p-5 shadow-sm hover:bg-slate-50 transition-colors">
                        <div class="w-10 h-10 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined">calendar_month</span>
                        </div>
                        <div>
                            <p class="font-bold text-sm text-slate-800">My Appointments</p>
                            <p class="text-xs text-slate-500">View & manage bookings</p>
                        </div>
                    </a>
                    <a href="/patient/profile"
                        class="flex items-center gap-4 bg-white border border-slate-100 rounded-2xl p-5 shadow-sm hover:bg-slate-50 transition-colors">
                        <div class="w-10 h-10 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center shrink-0">
                            <span class="material-symbols-outlined">manage_accounts</span>
                        </div>
                        <div>
                            <p class="font-bold text-sm text-slate-800">My Profile</p>
                            <p class="text-xs text-slate-500">Update your details</p>
                        </div>
                    </a>

                </div>
            </div>

            <!-- Recent Appointments Table -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100">
                <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
                    <h3 class="font-bold text-lg text-slate-800">Recent Appointments</h3>
                    <a href="/patient/appointments" class="text-primary text-sm font-medium hover:underline">View All</a>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="bg-slate-50 text-xs text-slate-500 uppercase tracking-wide border-b border-slate-100">
                                <th class="px-6 py-3 font-semibold">Doctor</th>
                                <th class="px-6 py-3 font-semibold">Speciality</th>
                                <th class="px-6 py-3 font-semibold">Hospital</th>
                                <th class="px-6 py-3 font-semibold">Date</th>
                                <th class="px-6 py-3 font-semibold">Status</th>
                                <th class="px-6 py-3 font-semibold">Details</th>
                            </tr>
                        </thead>
                        <tbody id="appointmentsBody" class="divide-y divide-slate-100">
                            <% if (!dashboard.recentAppointments || dashboard.recentAppointments.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="px-6 py-12 text-center text-slate-400 text-sm">
                                        No recent appointments found
                                    </td>
                                </tr>
                            <% } else { %>
                                <% dashboard.recentAppointments.forEach(appt => { %>
                                    <tr class="hover:bg-slate-50 transition-colors">
                                        <td class="px-6 py-4 text-sm font-medium text-slate-800"><%= appt.doctor.fullName %></td>
                                        <td class="px-6 py-4 text-sm text-slate-500"><%= appt.doctor.speciality[0] || 'General' %></td>
                                        <td class="px-6 py-4 text-sm text-slate-500"><%= appt.hospital.branchName %></td>
                                        <td class="px-6 py-4 text-sm text-slate-500">
                                            <%= new Date(appt.appointmentDate).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %>
                                        </td>
                                        <td class="px-6 py-4">
                                            <% 
                                                let displayStatus = appt.status;
                                                if (['BOOKED', 'RESCHEDULED'].includes(appt.status)) {
                                                    displayStatus = 'COMPLETED';
                                                }
                                            %>
                                            <span class="px-2.5 py-1 rounded-full text-[11px] font-bold uppercase tracking-wide <%= 
                                                displayStatus === 'COMPLETED' ? 'bg-emerald-50 text-emerald-700' :
                                                displayStatus === 'CANCELLED' ? 'bg-red-50 text-red-600' :
                                                displayStatus === 'ON_GOING' ? 'bg-emerald-50 text-emerald-700' :
                                                displayStatus === 'NO_SHOW' ? 'bg-amber-50 text-amber-700' : 'bg-slate-100 text-slate-500'
                                            %>">
                                                <%= displayStatus %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4">
                                            <button onclick="openDetails('<%= appt.id %>')" class="text-xs px-2.5 py-1 bg-slate-100 text-slate-600 rounded-lg hover:bg-slate-200 transition-colors font-medium cursor-pointer">
                                                View Details
                                            </button>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>           </div>
            </div>

        </div>
    </main>
</div><%- include('partials/detailsModal') %>

<script src="/js/patient/utils.js"></script>
<script src="/js/patient/api-client.js"></script>
<script src="/js/patient/detailsModal.js"></script>
<script>
    window.appointmentsList = <%- JSON.stringify(dashboard.recentAppointments || []) %>;
</script>
<script src="/js/patient/fetchDashboard.js"></script>
</body>
</html>
